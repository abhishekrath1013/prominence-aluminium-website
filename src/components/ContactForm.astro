---
import { company } from "../data/company";
interface Props {
  tone?: "dark" | "light";
}
const { tone = "dark" } = Astro.props;
const isDark = tone === "dark";
---

<form
  class:list={["uf-contact-form", isDark && "uf-contact-form--dark"]}
  id="uf-contact-form"
  data-endpoint-email={company.email}
>
  <div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-2">
    <label class="uf-field">
      <span class="label-eyebrow">Name</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label class="uf-field">
      <span class="label-eyebrow">Phone Number</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>
    <label class="uf-field md:col-span-2">
      <span class="label-eyebrow">Email</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label class="uf-field md:col-span-2">
      <span class="label-eyebrow">Message</span>
      <textarea name="message" rows="3" required></textarea>
    </label>
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-6">
    <button type="submit" class="uf-frame-host group relative inline-flex items-center gap-3 border px-8 py-4 transition-precise">
      <span class="label-eyebrow">Send Message</span>
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="transition-precise group-hover:translate-x-1">
        <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
      </svg>
    </button>
    <p class="uf-form-status text-xs opacity-60" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .uf-contact-form {
    color: var(--color-ink);
  }

  .uf-contact-form--dark {
    color: var(--color-off-white);
  }

  .uf-field {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .uf-field input,
  .uf-field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid currentColor;
    opacity: 0.9;
    padding-block: 0.6rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: currentColor;
    resize: none;
    transition: border-color var(--duration-micro) ease;
  }

  .uf-field input:focus,
  .uf-field textarea:focus {
    outline: none;
    border-color: currentColor;
    opacity: 1;
  }

  .uf-contact-form button[type="submit"] {
    border-color: var(--color-brass);
    background: var(--color-brass);
    color: var(--color-white);
    transition: background var(--duration-micro) ease, border-color var(--duration-micro) ease, color var(--duration-micro) ease;
  }

  /* Light forms sit on an off-white section, so the hover state can safely
     invert to a black outline. Dark forms sit on var(--color-ink) — a black
     outline there would vanish, so they invert to off-white instead. */
  .uf-contact-form:not(.uf-contact-form--dark) button[type="submit"]:hover {
    background: transparent;
    border-color: #000;
    color: #000;
  }

  .uf-contact-form--dark button[type="submit"]:hover {
    background: transparent;
    border-color: var(--color-off-white);
    color: var(--color-off-white);
  }
</style>

<script>
  const form = document.getElementById("uf-contact-form") as HTMLFormElement | null;
  const status = form?.querySelector<HTMLParagraphElement>(".uf-form-status");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = form.dataset.endpointEmail ?? "enquiry@uniframe.com";
    const subject = encodeURIComponent(`Enquiry from ${data.get("name") ?? "Prominance website"}`);
    const body = encodeURIComponent(
      `Name: ${data.get("name")}\nPhone: ${data.get("phone")}\nEmail: ${data.get("email")}\n\n${data.get("message")}`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    if (status) status.textContent = "Opening your email client to send this enquiry…";
  });
</script>
