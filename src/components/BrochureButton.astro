---
---

<a
  href="/brochure/prominance-brochure.pdf"
  download
  class="uf-brochure-btn"
  aria-label="Download the Prominance brochure (PDF)"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 3V15M12 15L7 10M12 15L17 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M4 17V19C4 20.1046 4.89543 21 6 21H18C19.1046 21 20 20.1046 20 19V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <span class="label-eyebrow">Brochure</span>
</a>

<style>
  .uf-brochure-btn {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-off-white);
    padding: 0.85rem 1.25rem;
    box-shadow: 0 16px 32px -12px rgb(0 0 0 / 0.45);
    transition: background var(--duration-micro) ease, transform var(--duration-micro) var(--ease-precise);
  }

  .uf-brochure-btn:hover {
    background: var(--color-brass);
    transform: translateY(-2px);
  }

  @media (max-width: 36rem) {
    .uf-brochure-btn span {
      display: none;
    }
    .uf-brochure-btn {
      padding: 0.85rem;
    }
  }
</style>
