---
// "Inside the frame" — Robus 40 component showcase.
// Idle: the window stands centred. "View components" slides it to the left, dollies into the
// first component (the surrounding frame turns to glass) and flies that component, in 3D and
// turning slowly, out to the right with its description. Geometry/engine: src/animations/robus-components.ts
import { robusComponents as comps } from "../data/robus-components";

const pad = (n: number) => String(n).padStart(2, "0");
const total = comps.length;
---

<section
  class="rx"
  id="components"
  data-rx
  data-state="idle"
  aria-labelledby="rx-title"
  data-comps={JSON.stringify(comps)}
>
  <div class="rx-bg" aria-hidden="true"></div>
  <div class="rx-canvas" data-rx-canvas aria-hidden="true"></div>

  <!-- where the window is drawn: full-width & centred while idle, left half once opened -->
  <div class="rx-vp-frame" data-rx-vp-frame aria-hidden="true"></div>

  <svg class="rx-svg" data-rx-svg aria-hidden="true">
    <line data-rx-line x1="0" y1="0" x2="0" y2="0"></line>
    <g data-rx-pin>
      <circle class="rx-pin-ring" r="16"></circle>
      <circle class="rx-pin-dot" r="3.5"></circle>
    </g>
  </svg>

  <!-- ===== idle ===== -->
  <div class="rx-intro">
    <div class="container-frame rx-intro-grid">
      <div class="rx-intro-copy">
        <p class="label-eyebrow text-champagne">Under the hood</p>
        <h2 id="rx-title" class="display-md mt-4 text-balance">Little details make a massive difference.</h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ivory/60">
          Smooth movement, precise alignment, and that satisfying click when you close. Take a peek at the components working smartly behind the scenes to make every day effortless for you.
        </p>
      </div>

      <ol class="rx-index">
        {
          comps.map((c, i) => (
            <li>
              <button type="button" data-rx-pick={i} disabled aria-label={`View ${c.name}`}>
                <span>{pad(i + 1)}</span>
                {c.name}
              </button>
            </li>
          ))
        }
      </ol>

      <div class="rx-intro-cta">
        <button type="button" class="btn-lux label-eyebrow" data-rx-open disabled>
          <span>View components</span>
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1"></path></svg>
        </button>
        <p class="label-eyebrow mt-5 text-ivory/40" data-rx-hint>Drag to turn the frame</p>
      </div>
    </div>
  </div>

  <!-- ===== opened ===== -->
  <div class="rx-panel" aria-live="polite">
    <div class="rx-panel-inner">
      <div class="rx-bar">
        <button type="button" class="rx-back label-eyebrow" data-rx-close>
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1"></path></svg>
          <span>Full window</span>
        </button>
        <div class="rx-pager">
          <p class="label-eyebrow text-ivory/55"><span class="text-champagne" data-rx-count>01</span> / {pad(total)}</p>
          <button type="button" class="rx-ico" data-rx-prev aria-label="Previous component">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
          <button type="button" class="rx-ico" data-rx-next aria-label="Next component">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
        </div>
      </div>

      <!-- title row (one per component) -->
      <div class="rx-heads">
        {
          comps.map((c, i) => (
            <div data-rx-item={i} hidden={i !== 0} class="rx-head">
              <p class="label-eyebrow text-champagne">{c.kicker}</p>
              <h3 class="rx-name">{c.name}</h3>
            </div>
          ))
        }
      </div>

      <!-- the part is drawn here by the canvas; drag to turn it -->
      <div class="rx-stage" data-rx-vp-comp>
        <span class="rx-stage-hint label-eyebrow">Drag to turn</span>
      </div>

      <!-- description (one per component) -->
      <div class="rx-bodies">
        {
          comps.map((c, i) => (
            <article data-rx-item={i} hidden={i !== 0} class="rx-body">
              <p class="rx-desc">{c.description}</p>
            </article>
          ))
        }
      </div>

      <nav class="rx-chips" aria-label="Components">
        {
          comps.map((c, i) => (
            <button type="button" class="rx-chip" data-rx-chip={i} aria-label={c.name} title={c.name} aria-current={i === 0 ? "true" : "false"}>
              {pad(i + 1)}
            </button>
          ))
        }
      </nav>
    </div>
  </div>

  <p class="rx-loading label-eyebrow" data-rx-loading>Loading 3D…</p>
</section>

<style is:global>
  .rx {
    --rx-ease: var(--ease-lux);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    height: 100svh;
    min-height: 560px;
  }

  /* ---------- atmosphere ---------- */
  .rx-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, #0a0a0b 0%, #101012 55%, #0a0a0b 100%);
  }
  .rx-bg::before,
  .rx-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    transition: opacity 1.1s var(--rx-ease);
  }
  .rx-bg::before {
    background:
      radial-gradient(ellipse 34% 64% at 50% 52%, rgba(66, 155, 70, 0.2), transparent 70%),
      radial-gradient(ellipse 60% 26% at 50% 94%, rgba(66, 155, 70, 0.09), transparent 70%);
  }
  .rx-bg::after {
    opacity: 0;
    background:
      radial-gradient(ellipse 30% 56% at 25% 50%, rgba(66, 155, 70, 0.18), transparent 70%),
      radial-gradient(ellipse 28% 50% at 75% 46%, rgba(255, 255, 255, 0.05), transparent 70%);
  }
  .rx[data-state="open"] .rx-bg::before {
    opacity: 0;
  }
  .rx[data-state="open"] .rx-bg::after {
    opacity: 1;
  }

  .rx-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* ---------- where the window is drawn ---------- */
  .rx-vp-frame {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    top: 7%;
    bottom: 16%;
    cursor: grab;
    touch-action: pan-y;
    transition:
      right 1.05s var(--rx-ease),
      top 1.05s var(--rx-ease),
      bottom 1.05s var(--rx-ease);
  }
  .rx-vp-frame::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgb(241 236 226 / 0.16) 20%, rgb(241 236 226 / 0.16) 80%, transparent);
    opacity: 0;
    transition: opacity 0.8s ease 0.6s;
  }
  .rx[data-state="open"] .rx-vp-frame::after {
    opacity: 1;
  }
  .rx-vp-frame.is-drag,
  .rx-stage.is-drag {
    cursor: grabbing;
  }
  .rx[data-state="open"] .rx-vp-frame {
    right: 50%;
    top: 0;
    bottom: 0;
  }

  .rx-svg {
    display: none; /* no leader line / pin between the window and the part */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    opacity: var(--rx-line, 0);
  }
  .rx-svg line {
    stroke: rgba(66, 155, 70, 0.85);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .rx-pin-dot {
    fill: #5fbf63;
  }
  .rx-pin-ring {
    fill: none;
    stroke: rgba(95, 191, 99, 0.8);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: rx-pulse 2.4s var(--rx-ease) infinite;
  }
  @keyframes rx-pulse {
    0% { transform: scale(0.45); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* ---------- idle copy ---------- */
  .rx-intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    transition: opacity 0.7s ease, visibility 0.7s;
  }
  .rx[data-state="open"] .rx-intro {
    opacity: 0;
    visibility: hidden;
  }
  .rx-intro-grid {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: 1fr auto;
    align-items: center;
    padding-top: clamp(96px, 12svh, 132px);
    padding-bottom: clamp(28px, 5svh, 56px);
  }
  .rx-intro-copy {
    grid-column: 1;
    grid-row: 1;
    max-width: 24rem;
  }
  .rx-index {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: rgb(241 236 226 / 0.5);
  }
  .rx-index li {
    border-bottom: 1px solid rgb(241 236 226 / 0.08);
    min-width: 15rem;
  }
  .rx-index button {
    display: flex;
    width: 100%;
    gap: 1rem;
    align-items: baseline;
    padding: 0.3rem 0 0.55rem;
    text-align: left;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    transition: color 0.3s ease, transform 0.4s var(--rx-ease);
  }
  .rx-index button:hover,
  .rx-index button:focus-visible {
    color: var(--color-ivory);
    transform: translateX(-4px);
  }
  .rx-index button:disabled {
    cursor: progress;
  }
  .rx-index span {
    font-family: var(--font-poppins);
    font-size: 0.95rem;
    color: var(--color-champagne);
    width: 1.6rem;
  }
  .rx-intro-cta {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    text-align: center;
    pointer-events: auto;
  }
  .rx-intro-cta .btn-lux[disabled] {
    opacity: 0.45;
    pointer-events: none;
  }

  /* ---------- opened panel ---------- */
  .rx-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    right: 0;
    z-index: 3;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease, visibility 0.5s;
  }
  .rx[data-state="open"] .rx-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.9s ease 0.55s, visibility 0s 0.55s;
  }
  .rx-panel-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(92px, 11svh, 124px) var(--gutter) clamp(24px, 4svh, 44px) clamp(1rem, 3vw, 3.5rem);
  }
  .rx-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(241 236 226 / 0.12);
  }
  .rx-back {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: rgb(241 236 226 / 0.7);
    transition: color 0.3s ease;
  }
  .rx-back:hover {
    color: var(--color-ivory);
  }
  .rx-pager {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .rx-ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgb(241 236 226 / 0.25);
    border-radius: 999px;
    color: var(--color-ivory);
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }
  .rx-ico:hover {
    background: var(--color-champagne);
    border-color: var(--color-champagne);
    color: var(--color-ink);
  }
  .rx-heads {
    padding-top: clamp(0.9rem, 2.2svh, 1.5rem);
  }
  /* every component's text is stacked in one grid cell, so the panel is always as tall as the
     longest one and nothing jumps when you step between components */
  .rx-heads,
  .rx-bodies {
    display: grid;
  }
  .rx-heads > *,
  .rx-bodies > * {
    grid-area: 1 / 1;
  }
  .rx-heads > [hidden],
  .rx-bodies > [hidden] {
    display: block;
    visibility: hidden;
  }
  .rx-name,
  #rx-title {
    font-family: var(--font-poppins);
    font-weight: 300;
    font-size: clamp(2rem, 3.1vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .rx-name {
    margin-top: 0.5rem;
  }
  .rx-stage {
    position: relative;
    flex: 1 1 0;
    min-height: 120px;
    margin: clamp(0.4rem, 1.5svh, 1rem) 0;
    cursor: grab;
    touch-action: pan-y;
  }
  .rx-stage-hint {
    position: absolute;
    left: 0;
    bottom: 0;
    color: rgb(241 236 226 / 0.35);
    pointer-events: none;
  }
  .rx-desc {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.2rem, 1.7vw, 1.6rem);
    line-height: 1.32;
    color: rgb(241 236 226 / 0.9);
    max-width: 34rem;
  }
  .rx-chips {
    padding-top: clamp(1rem, 2.4svh, 1.6rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .rx-chip {
    min-width: 2.5rem;
    height: 2.1rem;
    padding: 0 0.7rem;
    border: 1px solid rgb(241 236 226 / 0.2);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: rgb(241 236 226 / 0.6);
    transition: all 0.35s ease;
  }
  .rx-chip:hover {
    border-color: rgb(241 236 226 / 0.55);
    color: var(--color-ivory);
  }
  .rx-chip[aria-current="true"] {
    background: var(--color-champagne);
    border-color: var(--color-champagne);
    color: var(--color-ink);
  }

  .rx-loading {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    color: rgb(241 236 226 / 0.45);
    pointer-events: none;
  }
  .rx-loading[hidden] {
    display: none;
  }

  /* ---------- tablet / phone: window on top, part below, description under that ---------- */
  @media (max-width: 1023px) {
    /* leave the heading and paragraph clear above the window */
    .rx-vp-frame {
      top: clamp(300px, 38svh, 420px);
      bottom: 17%;
    }
    .rx[data-state="open"] .rx-vp-frame {
      right: 0;
      top: 0;
      bottom: auto;
      height: 38svh;
    }
    .rx-intro-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      align-items: start;
    }
    .rx-intro-copy {
      grid-row: 1;
      max-width: 30rem;
    }
    .rx-index {
      display: none;
    }
    .rx-intro-cta {
      grid-row: 3;
    }
    .rx-panel {
      left: 0;
      top: 38svh;
    }
    .rx-panel-inner {
      padding: 0.75rem var(--gutter) 1.25rem;
    }
    .rx-bar {
      padding-bottom: 0.6rem;
    }
    .rx-heads {
      padding-top: 0.6rem;
    }
    .rx-name {
      font-size: clamp(1.6rem, 6vw, 2.2rem);
    }
    .rx-desc {
      font-size: 1.05rem;
    }
    [data-rx-hint] {
      display: none;
    }
  }
</style>

<script>
  import { robusComponents } from "../data/robus-components";

  const root = document.querySelector<HTMLElement>("[data-rx]");
  if (root) {
    let started = false;

    /** No WebGL (or it failed): the same panel works as a plain text tour. */
    const textOnly = (msg: string) => {
      const loading = root.querySelector<HTMLElement>("[data-rx-loading]");
      if (loading) {
        loading.textContent = msg;
        loading.hidden = false;
      }
      const items = Array.from(root.querySelectorAll<HTMLElement>("[data-rx-item]"));
      const chips = Array.from(root.querySelectorAll<HTMLElement>("[data-rx-chip]"));
      const count = root.querySelector<HTMLElement>("[data-rx-count]");
      let i = 0;
      const show = (n: number) => {
        i = (n + robusComponents.length) % robusComponents.length;
        items.forEach((el) => (el.hidden = Number(el.dataset.rxItem) !== i));
        chips.forEach((c, k) => c.setAttribute("aria-current", String(k === i)));
        if (count) count.textContent = String(i + 1).padStart(2, "0");
      };
      const btn = root.querySelector<HTMLButtonElement>("[data-rx-open]")!;
      btn.disabled = false;
      const openAt = (n: number) => {
        root.dataset.state = "open";
        if (loading) loading.hidden = true;
        show(n);
      };
      btn.addEventListener("click", () => openAt(0));
      root.querySelectorAll<HTMLElement>("[data-rx-pick]").forEach((b) => {
        (b as HTMLButtonElement).disabled = false;
        b.addEventListener("click", () => openAt(Number(b.dataset.rxPick)));
      });
      root.querySelector("[data-rx-close]")?.addEventListener("click", () => (root.dataset.state = "idle"));
      root.querySelector("[data-rx-prev]")?.addEventListener("click", () => show(i - 1));
      root.querySelector("[data-rx-next]")?.addEventListener("click", () => show(i + 1));
      chips.forEach((c, k) => c.addEventListener("click", () => show(k)));
    };

    const boot = async () => {
      if (started) return;
      started = true;
      try {
        const probe = document.createElement("canvas");
        if (!(probe.getContext("webgl2") || probe.getContext("webgl"))) throw new Error("no webgl");
        // a flaky first load of the 3D module (network hiccup, dev-server rebuild) gets one more try before we give up
        let mod: typeof import("../animations/robus-components");
        try {
          mod = await import("../animations/robus-components");
        } catch (first) {
          console.warn("[robus-components] retrying module load", first);
          await new Promise((r) => setTimeout(r, 1200));
          mod = await import("../animations/robus-components");
        }
        await mod.mountRobusComponents(root, robusComponents);
      } catch (e) {
        console.warn("[robus-components]", e);
        const noGl = e instanceof Error && e.message === "no webgl";
        textOnly(noGl ? "3D preview needs WebGL — the component guide still works." : "The 3D preview couldn’t load — the component guide still works.");
      }
    };
    new IntersectionObserver((es) => es.some((e) => e.isIntersecting) && boot(), { rootMargin: "1400px 0px" }).observe(root);
  }
</script>
