---
// The signature architectural frame motif: a thin rule with four corner
// brackets, used around imagery, section transitions, and hover states
// throughout the site.
interface Props {
  class?: string;
  hover?: boolean; // brackets expand slightly on hover of the containing element
  tone?: "ink" | "off-white";
}

const { class: className = "", hover = false, tone = "ink" } = Astro.props;
const color = tone === "ink" ? "text-ink" : "text-off-white";
---

<span
  class:list={["uf-frame pointer-events-none absolute inset-0 z-10", color, hover && "uf-frame--hover", className]}
  aria-hidden="true"
>
  <span class="uf-frame__border"></span>
  <span class="uf-frame__corner uf-frame__corner--tl"></span>
  <span class="uf-frame__corner uf-frame__corner--tr"></span>
  <span class="uf-frame__corner uf-frame__corner--bl"></span>
  <span class="uf-frame__corner uf-frame__corner--br"></span>
</span>

<style>
  .uf-frame__border {
    position: absolute;
    inset: 0;
    border: 1px solid currentColor;
    opacity: 0.18;
    transition: opacity var(--duration-normal) var(--ease-precise);
  }

  .uf-frame__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0.85;
    transition:
      width var(--duration-normal) var(--ease-precise),
      height var(--duration-normal) var(--ease-precise),
      opacity var(--duration-normal) var(--ease-precise);
  }

  .uf-frame__corner::before,
  .uf-frame__corner::after {
    content: "";
    position: absolute;
    background: currentColor;
  }

  .uf-frame__corner::before {
    width: 100%;
    height: 1px;
    top: 0;
    left: 0;
  }

  .uf-frame__corner::after {
    width: 1px;
    height: 100%;
    top: 0;
    left: 0;
  }

  .uf-frame__corner--tl {
    top: -1px;
    left: -1px;
  }

  .uf-frame__corner--tr {
    top: -1px;
    right: -1px;
    transform: scaleX(-1);
  }

  .uf-frame__corner--bl {
    bottom: -1px;
    left: -1px;
    transform: scaleY(-1);
  }

  .uf-frame__corner--br {
    bottom: -1px;
    right: -1px;
    transform: scale(-1, -1);
  }

  .uf-frame--hover .uf-frame__corner {
    width: 10px;
    height: 10px;
    opacity: 0.55;
  }

  :global(.uf-frame-host:hover) .uf-frame--hover .uf-frame__corner {
    width: 20px;
    height: 20px;
    opacity: 1;
  }

  :global(.uf-frame-host:hover) .uf-frame--hover .uf-frame__border {
    opacity: 0.4;
  }
</style>
