---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Frame from "./Frame.astro";

interface Props {
  eyebrow: string;
  image: ImageMetadata;
  imageAlt: string;
  height?: "full" | "tall";
}
const { eyebrow, image, imageAlt, height = "tall" } = Astro.props;
const heightClass = height === "full" ? "h-[100svh] min-h-[640px]" : "h-[75svh] min-h-[460px]";
---

<section class:list={["relative w-full overflow-hidden bg-ink", heightClass]} data-reveal-group>
  <Image
    src={image}
    alt={imageAlt}
    class="h-full w-full object-cover"
    fetchpriority="high"
    widths={[640, 1200, 1920]}
    sizes="100vw"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/15 to-ink/45"></div>
  <div class="pointer-events-none absolute inset-3 md:inset-6"><Frame tone="off-white" /></div>

  <div class="container-frame absolute inset-x-0 bottom-14 md:bottom-16">
    <p class="label-eyebrow text-off-white/70" data-reveal="fade">{eyebrow}</p>
    <h1 class="mt-5 font-display text-[clamp(2.75rem,7.5vw,5.5rem)] leading-[0.98] text-off-white text-balance" data-reveal="up">
      <slot />
    </h1>
    <div class="mt-6 max-w-lg text-base leading-relaxed text-off-white/75" data-reveal="up">
      <slot name="description" />
    </div>
  </div>
</section>
