---
// The contact section shown above the footer on every page — the Prominance Window Systems enquiry block.
import ContactCta from "./ContactCta.astro";
interface Props {
  tone?: "default";
  eyebrow?: string;
  title?: string[];
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<ContactCta eyebrow={eyebrow} title={title} lead={lead} />
