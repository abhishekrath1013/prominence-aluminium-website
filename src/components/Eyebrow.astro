---
interface Props {
  // Accepted but intentionally not rendered — subhead numerals were removed
  // site-wide, kept here so the ~35 existing call sites don't need touching.
  index?: string;
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<p class:list={["label-eyebrow", className]}>
  <slot />
</p>
