---
import { Image } from "astro:assets";
import Frame from "./Frame.astro";
import Eyebrow from "./Eyebrow.astro";
import ArrowLink from "./ArrowLink.astro";
import ContactForm from "./ContactForm.astro";
import type { Product } from "../data/products";
import { relatedProducts } from "../data/products";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const related = relatedProducts(product.slug, 3);

const specGroups = [
  { title: "Frame", rows: product.frame },
  { title: "Glazing", rows: product.glazing },
  { title: "Sash", rows: product.sash },
  { title: "Performance", rows: product.performance },
];
---

<section class="relative h-[85svh] min-h-[520px] w-full overflow-hidden bg-ink" data-reveal-group>
  <Image
    src={product.heroImage}
    alt={`${product.fullTitle} — ${product.headline}`}
    class="h-full w-full object-cover"
    fetchpriority="high"
    widths={[640, 1200, 1920]}
    sizes="100vw"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/10 to-ink/50"></div>
  <div class="pointer-events-none absolute inset-3 md:inset-6"><Frame tone="off-white" /></div>

  <div class="container-frame absolute inset-x-0 bottom-16 md:bottom-20">
    <p class="label-eyebrow text-off-white/70" data-reveal="fade">{product.family === "sliding" ? "Sliding System" : "Casement System"}</p>
    <h1 class="mt-5 font-display text-[clamp(3rem,9vw,6.5rem)] leading-[0.95] text-off-white" data-reveal="up">
      {product.name}
    </h1>
    <p class="mt-6 max-w-lg text-base leading-relaxed text-off-white/75" data-reveal="up">{product.headline}</p>
  </div>
</section>

<section class="bg-off-white py-14 md:py-20" data-reveal-group>
  <div class="container-frame grid grid-cols-1 gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <Eyebrow index="01" class="text-ink/65" data-reveal="fade">Description</Eyebrow>
    </div>
    <div class="md:col-span-8">
      <p class="max-w-2xl font-display text-2xl leading-snug text-ink md:text-3xl" data-reveal="up">
        {product.description}
      </p>
      <p class="mt-8 max-w-xl text-sm leading-relaxed text-ink/60" data-reveal="up">
        <span class="label-eyebrow text-ink/60">Applications — </span>
        {product.applications}
      </p>
    </div>
  </div>
</section>

<section class="bg-off-white pb-14 md:pb-20" data-reveal-group>
  <div class="container-frame uf-frame-host relative" data-reveal="up">
    <div class="relative aspect-[16/9] w-full overflow-hidden">
      <Image
        src={product.heroImage}
        alt={`${product.fullTitle} detail view.`}
        class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.02]"
        loading="lazy"
        widths={[640, 1200, 1920]}
        sizes="100vw"
      />
    </div>
    <Frame hover />
  </div>
</section>

<section class="bg-ink py-20 text-off-white md:py-28" data-reveal-group>
  <div class="container-frame">
    <Eyebrow index="02" class="text-aluminium" data-reveal="fade">Key Specifications</Eyebrow>
    <h2 class="mt-6 max-w-xl font-display text-[clamp(2rem,4vw,3rem)] leading-[1.08]" data-reveal="up">
      Engineered to the millimetre.
    </h2>

    <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-4">
      {
        specGroups.map((group) => (
          <div data-reveal="up">
            <p class="label-eyebrow text-aluminium">{group.title}</p>
            <dl class="mt-6 flex flex-col gap-4">
              {group.rows.map((row) => (
                <div class="border-t border-off-white/10 pt-3">
                  <dt class="text-xs text-stone">{row.label}</dt>
                  <dd class="mt-1 text-sm text-off-white">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <div class="mt-16 grid grid-cols-1 gap-8 border-t border-off-white/10 pt-10 md:grid-cols-2" data-reveal="up">
      <div>
        <p class="label-eyebrow text-aluminium">Hardware</p>
        <p class="mt-3 text-sm leading-relaxed text-stone">{product.hardware}</p>
      </div>
      <div>
        <p class="label-eyebrow text-aluminium">Finishes</p>
        <p class="mt-3 text-sm leading-relaxed text-stone">
          Available across Prominance’s full finish range of 100+ anodised, powder-coated and metallic colours.
          <a href="/products/#finishes" class="ml-1 underline decoration-off-white/30 underline-offset-4 hover:decoration-off-white">View finishes</a>.
        </p>
      </div>
    </div>
  </div>
</section>

{
  related.length > 0 && (
    <section class="bg-off-white py-14 md:py-20" data-reveal-group>
      <div class="container-frame flex items-end justify-between">
        <Eyebrow index="03" class="text-ink/65" data-reveal="fade">Related Systems</Eyebrow>
      </div>
      <div class="container-frame mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3">
        {related.map((p) => (
          <a href={`/${p.slug}/`} class="uf-frame-host group relative block" data-reveal="up" data-cursor-hover>
            <div class="relative aspect-[4/3] w-full overflow-hidden">
              <Image
                src={p.cardImage}
                alt={p.fullTitle}
                class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.02]"
                loading="lazy"
                widths={[300, 600, 900]}
                sizes="(min-width: 640px) 33vw, 100vw"
              />
              <Frame hover />
            </div>
            <p class="mt-5 label-eyebrow text-ink/60">{p.category}</p>
            <p class="mt-2 font-display text-2xl text-ink">{p.name}</p>
          </a>
        ))}
      </div>
    </section>
  )
}

<section class="bg-ink py-20 text-off-white md:py-28" data-reveal-group>
  <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Eyebrow index="04" class="text-aluminium" data-reveal="fade">Specify {product.name}</Eyebrow>
      <h2 class="mt-6 font-display text-[clamp(2rem,4vw,3rem)] leading-[1.08] text-balance" data-reveal="up">
        Talk to our team about this system.
      </h2>
      <div class="mt-8" data-reveal="up">
        <ArrowLink href="/contact-us/" variant="light">Or visit our contact page</ArrowLink>
      </div>
    </div>
    <div class="md:col-span-7" data-reveal="up">
      <ContactForm tone="dark" />
    </div>
  </div>
</section>
