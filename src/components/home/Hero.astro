---
// Hero — "Prominance makes your view prominant" over the glass-façade photograph, SRK pointing at the headline.
// The section is exactly one screen tall. Sizes come from the 1326 × 880 design scaled to fit the screen height
// (var(--u)); horizontally the content is pinned to the left and right edges, so wide screens stretch instead of
// leaving empty margins.
import { Image } from "astro:assets";
import bg from "../../assets/home/hero-bg.jpg";
import srk from "../../assets/home/srk-hero.webp";
import HomeNav from "./HomeNav.astro";
---

<section class="hh uf-panel" data-panel style="z-index:1" aria-labelledby="hh-title">
  <Image src={bg} alt="" class="hh__bg" data-hm="hero-bg" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="hh__shade" aria-hidden="true"></div>

  <div class="hh__stage">
    <Image src={srk} alt="" class="hh__srk" data-hm="hero-srk" widths={[565]} sizes="(max-width: 800px) 60vw, 43vw" loading="eager" />
    <HomeNav />
    <div class="hh__copy">
      <h1 id="hh-title" aria-label="Exquisite by design. Enduring by nature.">
        <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hero-line">Exquisite by design.</span></span>
        <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hero-line">Enduring by nature.</span></span>
      </h1>
      <p data-hm="hero-fade">Classy aluminium window and door systems<br /> that stay gorgeous for generations.</p>
      <a href="/products/" class="hh__btn" data-hm="hero-fade">Explore Products</a>
    </div>
  </div>
</section>

<style is:global>
  .hh {
    container-type: size;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    height: 100svh;
    min-height: 520px;
    background: #0a0a0b;
    color: #fff;
  }
  .hh__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0% 50%;
  }
  .hh__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 10 12 / 0.82) 0%, rgb(8 10 12 / 0.5) 24%, rgb(8 10 12 / 0.5) 70%, rgb(8 10 12 / 0.55) 100%),
      linear-gradient(90deg, rgb(8 10 12 / 0.72) 0%, rgb(8 10 12 / 0.4) 40%, transparent 68%);
  }
  /* full-width band, as tall as the design scaled to fit the screen height, centred vertically */
  .hh__stage {
    --u: calc(min(100cqw, 100cqh * 1326 / 880) / 1326);
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(880 * var(--u));
  }
  .hh__srk {
    position: absolute;
    right: calc(10 * var(--u));
    top: calc(165 * var(--u));
    width: calc(565 * var(--u));
    height: calc(717 * var(--u));
    max-width: none;
  }
  .hh__copy {
    position: absolute;
    z-index: 1;
    inset: 0;
  }
  .hh h1 {
    position: absolute;
    left: calc(80 * var(--u));
    top: calc(187 * var(--u));
    white-space: nowrap;
    font-family: var(--font-poppins);
    font-weight: 700;
    font-size: calc(84 * var(--u));
    line-height: calc(88 * var(--u)); /* was 74u: the descenders of line 1 touched the capitals of line 2 */
    letter-spacing: -0.03em;
    color: #e8e6e5;
  }
  .hh__copy p {
    position: absolute;
    left: calc(80 * var(--u));
    top: calc(392 * var(--u)); /* below the two-line headline (the design had three lines, so this sits higher than the design's 436u) */
    white-space: nowrap;
    font-size: calc(20 * var(--u));
    line-height: calc(30 * var(--u));
    font-weight: 500;
    color: rgb(255 255 255 / 0.92);
  }
  .hh__btn {
    position: absolute;
    left: calc(78 * var(--u));
    top: calc(488 * var(--u));
    width: calc(370 * var(--u));
    height: calc(78 * var(--u));
    display: grid;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    /* resting state: outline only, white text */
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: calc(6 * var(--u));
    background: transparent;
    font-family: var(--font-poppins);
    font-weight: 600;
    font-size: calc(17 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-lux);
  }
  /* hover / keyboard focus: fills with the blue gradient and the text turns green */
  .hh__btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 80% 120% at 50% 0%, #0c4d71 0%, #08334f 48%, #05192d 100%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hh__btn:hover,
  .hh__btn:focus-visible {
    color: #49e858;
    border-color: rgb(255 255 255 / 0.1);
    transform: translateY(-2px);
  }
  .hh__btn:hover::before,
  .hh__btn:focus-visible::before {
    opacity: 1;
  }

  /* phone: flow the copy instead of scaling the stage */
  @media (max-width: 800px) {
    .hh {
      container-type: normal;
      height: max(100svh, 640px);
    }
    .hh__stage {
      position: absolute;
      inset: 0;
      translate: none;
      height: auto;
    }
    .hh__srk {
      left: auto;
      top: auto;
      right: -12vw;
      bottom: 0;
      width: auto;
      height: 58%;
      opacity: 0.9;
    }
    .hh__copy {
      inset: auto;
      left: 1.25rem;
      right: 1.25rem;
      top: 17%;
    }
    .hh h1,
    .hh__copy p,
    .hh__btn {
      position: static;
    }
    .hh h1 {
      font-size: clamp(1.5rem, 8vw, 3.4rem); /* "Exquisite by design." is a longer line than the old headline, so it has to be smaller to fit */
      line-height: 1.08;
    }
    .hh__copy p {
      margin-top: 1.1rem;
      font-size: 1rem;
      line-height: 1.5;
      white-space: normal;
    }
    .hh__copy p br {
      display: none; /* let the sentence wrap naturally on narrow screens */
    }
    .hh__btn {
      margin-top: 1.5rem;
      width: min(100%, 14.5rem);
      height: 3.4rem;
      font-size: 0.85rem;
      border-radius: 6px;
    }
  }
</style>
