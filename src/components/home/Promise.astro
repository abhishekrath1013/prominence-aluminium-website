---
// Two one-screen sections from the design's "21-Day-BG" block:
//   1. "Built with precision…" + the factory aerial   (design stage 1326 × 968)
//   2. "21-DAY DELIVERY"                              (design stage 1326 × 533)
// Each section is exactly one screen tall, its stage scaled to fit, every length calc(N * var(--u)).
import { Image } from "astro:assets";
import bgA from "../../assets/home/promise-a.jpg";
import bgB from "../../assets/home/promise-b.jpg";
import factory from "../../assets/home/factory.jpg";
---

<section class="hp" aria-labelledby="hp-title">
  <Image src={bgA} alt="" class="hp__bg" data-hm="hp-bg" widths={[1326, 1800]} sizes="100vw" loading="lazy" />

  <div class="hp__stage">
    <h2 id="hp-title" class="hp__statement" aria-label="Built with precision. Delivered with promise. Crafted to endure.">
      <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hp-line">Built with precision.</span></span>
      <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hp-line">Delivered with promise.</span></span>
      <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hp-line">Crafted to endure.</span></span>
    </h2>
  </div>

  <!-- full-bleed band, vertically placed by the stage's scale -->
  <div class="hp__factory" data-hm="hp-factory">
    <Image src={factory} alt="Aerial view of the Prominance manufacturing campus" widths={[1200, 1800, 2400]} sizes="100vw" loading="lazy" />
  </div>
</section>

<section class="hd" aria-label="21-day delivery">
  <Image src={bgB} alt="" class="hd__bg" data-hm="hd-bg" widths={[1326, 1800]} sizes="100vw" loading="lazy" />

  <div class="hd__stage">
    <div class="hd__graphic" role="img" aria-label="21-day delivery">
      <span class="hd__21" data-hm="hd-21">21</span>
      <span class="hd__dash" data-hm="hd-dash"></span>
      <span class="hd__day" data-hm="hd-day">DAy</span>
      <span class="hd__delivery" data-hm="hd-delivery">DELIVERY</span>
    </div>

    <div class="hd__copy">
      <p><span data-hm="hd-copy">Delivered in just 21 days. Guaranteed for over </span><span data-hm="hd-copy">25&nbsp;years. From blueprint to bolt, every detail is </span><span data-hm="hd-copy">designed, engineered and built under one roof.</span></p>
      <p class="hd__way" data-hm="hd-copy">The Prominance way.</p>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- 1. statement + factory ---------- */
  .hp,
  .hd {
    container-type: size;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100svh;
    min-height: 520px;
    background: #1a191d;
  }
  .hp__bg,
  .hd__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* full-width bands, as tall as the design scaled to fit the screen height, centred vertically */
  .hp__stage {
    --u: calc(min(100cqw, 100cqh * 1326 / 968) / 1326);
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(968 * var(--u));
  }
  .hp__statement {
    position: absolute;
    left: calc(111 * var(--u));
    top: calc(119 * var(--u));
    white-space: nowrap;
    font-family: var(--font-poppins);
    font-weight: 700;
    font-size: calc(71.9 * var(--u));
    line-height: calc(77 * var(--u));
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #e6e6e6;
  }
  .hp__factory {
    --u: calc(min(100cqw, 100cqh * 1326 / 968) / 1326);
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(50% + (454 - 484) * var(--u));
    height: calc(515 * var(--u));
    overflow: hidden;
    background: #26332a;
  }
  .hp__factory img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 22%;
  }

  /* ---------- 2. 21-day delivery ---------- */
  .hd__bg {
    object-position: 50% 100%;
  }
  .hd__stage {
    --u: calc(min(100cqw, 100cqh * 1326 / 533) / 1326);
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(533 * var(--u));
  }
  /* the "21-DAY DELIVERY" lockup: 538 × 262, its parts sized in its own width (cqw) so it scales as one piece */
  .hd__graphic {
    container-type: inline-size;
    position: absolute;
    left: calc(127 * var(--u));
    top: calc(119 * var(--u));
    width: calc(538 * var(--u));
    height: calc(262 * var(--u));
    color: #fff;
    font-family: var(--font-poppins);
    line-height: 1;
    user-select: none;
  }
  .hd__graphic > span {
    position: absolute;
    display: block;
    white-space: nowrap;
  }
  .hd__21 {
    left: -1cqw;
    top: -6.9cqw;
    font-weight: 200;
    font-size: 49cqw;
    letter-spacing: -0.065em;
    color: #4b9a4b;
  }
  .hd__dash {
    left: 33.8cqw;
    top: 21.2cqw;
    width: 4.7cqw;
    height: 2.2cqw;
    background: linear-gradient(90deg, #4b9a4b, #076ea1);
  }
  .hd__day {
    left: 40.2cqw;
    top: 3cqw;
    font-weight: 300;
    font-size: 36.4cqw;
    letter-spacing: -0.06em;
    color: var(--color-brand-blue);
  }
  .hd__delivery {
    left: 0.2cqw;
    top: 39cqw;
    font-weight: 600;
    font-size: 8cqw;
    letter-spacing: 0.92em;
  }
  .hd__copy {
    position: absolute;
    right: calc(57 * var(--u)); /* pinned to the right margin: the text block starts 749u from the left at design width */
    top: calc(206 * var(--u));
    width: calc(520 * var(--u));
    white-space: nowrap;
  }
  .hd__copy p {
    font-size: calc(23 * var(--u));
    line-height: calc(35 * var(--u));
    font-weight: 400;
    color: #9a9a9b;
  }
  .hd__copy p > span {
    display: block; /* the design breaks the paragraph into these three lines */
  }
  .hd__copy .hd__way {
    margin-top: calc(6 * var(--u));
    font-weight: 700;
    font-size: calc(33 * var(--u));
    line-height: calc(40 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #98989a;
  }

  /* ---------- phone: stack instead of scaling the stage ---------- */
  @media (max-width: 860px) {
    .hp,
    .hd {
      container-type: normal;
      height: auto;
      min-height: 0;
    }
    .hp__stage,
    .hd__stage {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      translate: none;
      height: auto;
    }
    .hp__statement {
      position: relative;
      left: auto;
      top: auto;
      padding: 3.5rem 1.25rem 3rem;
      font-size: clamp(1.7rem, 7.4vw, 3rem);
      line-height: 1.1;
      white-space: normal;
    }
    .hp__factory {
      position: relative;
      top: auto;
      height: auto;
      aspect-ratio: 1326 / 515;
    }
    .hd__stage {
      padding: 3rem 0 3.5rem;
    }
    .hd__graphic {
      position: relative;
      left: auto;
      top: auto;
      width: min(80vw, 22rem);
      height: auto;
      aspect-ratio: 538 / 262;
      margin: 0 1.25rem;
    }
    .hd__copy {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      width: auto;
      white-space: normal;
      margin: 2.5rem 1.25rem 0;
    }
    .hd__copy p {
      font-size: 1.1rem;
      line-height: 1.55;
    }
    .hd__copy p > span {
      display: inline;
    }
    .hd__copy .hd__way {
      font-size: 1.4rem;
      line-height: 1.3;
    }
  }
</style>
