---
// Two one-screen sections from the design's "21-Day-BG" block:
//   1. "Built with precision…" + the factory aerial   (design stage 1326 × 968)
//   2. "21-DAY DELIVERY"                              (design stage 1326 × 533)
// Each section is exactly one screen tall, its stage scaled to fit, every length calc(N * var(--u)).
import { Image } from "astro:assets";
import bgA from "../../assets/home/promise-a.jpg";
import bgB from "../../assets/home/promise-b.jpg";
import factory from "../../assets/home/factory.jpg";
---

<section class="hp" aria-labelledby="hp-title">
  <Image src={bgA} alt="" class="hp__bg" data-hm="hp-bg" widths={[1326, 1800]} sizes="100vw" loading="lazy" />

  <div class="hp__stage">
    <p class="hp__eyebrow" data-hm="hp-eyebrow">In-House Manufacturing</p>
    <h2 id="hp-title" class="hp__statement" aria-label="Delivered right on time. Built to last a lifetime.">
      <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hp-line">Delivered right on time.</span></span>
      <span class="ln" aria-hidden="true"><span class="ln__t" data-hm="hp-line">Built to last a lifetime.</span></span>
    </h2>
  </div>

  <!-- full-bleed band, vertically placed by the stage's scale -->
  <div class="hp__factory" data-hm="hp-factory">
    <Image src={factory} alt="Aerial view of the Prominance manufacturing campus" widths={[1200, 1800, 2400]} sizes="100vw" loading="lazy" />
  </div>
</section>

<section class="hd" aria-label="21-day delivery">
  <Image src={bgB} alt="" class="hd__bg" data-hm="hd-bg" widths={[1326, 1800]} sizes="100vw" loading="lazy" />

  <div class="hd__stage">
    <div class="hd__graphic" role="img" aria-label="21-day delivery">
    <svg class="hd__svg" viewBox="0 0 538 248" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
