    </svg>
    </div>

    <div class="hd__copy">
      <p><span data-hm="hd-copy">Spanning an impressive 6&nbsp;lakh sq.&nbsp;ft., </span><span data-hm="hd-copy">our world-class manufacturing facility </span><span data-hm="hd-copy">brings together cutting-edge robotics, </span><span data-hm="hd-copy">sophisticated automation and an </span><span data-hm="hd-copy">unwavering pursuit of excellence.</span></p>
      <p class="hd__way" data-hm="hd-copy">The Prominance way.</p>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- 1. statement + factory ---------- */
  .hp,
  .hd {
    container-type: size;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100svh;
    min-height: 520px;
    background: #1a191d;
  }
  .hp__bg,
  .hd__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* full-width bands, as tall as the design scaled to fit the screen height, centred vertically */
  .hp__stage {
    --u: calc(min(100cqw, 100cqh * 1326 / 968) / 1326);
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(968 * var(--u));
  }
  /* small green tag above the statement */
  .hp__eyebrow {
    position: absolute;
    left: calc(113 * var(--u));
    top: calc(84 * var(--u));
    font-family: var(--font-sans);
    font-size: calc(14 * var(--u));
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-champagne);
  }
  /* same voice as the "Tailored to your taste." heading: light Poppins, sentence case, ivory */
  .hp__statement {
    position: absolute;
    left: calc(111 * var(--u));
    top: calc(119 * var(--u));
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: calc(71.9 * var(--u));
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-ivory);
  }
  .hp__factory {
    --u: calc(min(100cqw, 100cqh * 1326 / 968) / 1326);
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(50% + (380 - 484) * var(--u)); /* design: 454u / 515u tall. The statement is two lines now, so the band can start higher and show more of the photo */
    height: calc(588 * var(--u));
    overflow: hidden;
    background: #26332a;
  }
  .hp__factory img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 52%; /* frames the buildings' glazed fronts and the car park, not just the roofs */
  }

  /* ---------- 2. 21-day delivery ---------- */
  .hd__bg {
    object-position: 50% 100%;
  }
  .hd__stage {
    --u: calc(min(100cqw, 100cqh * 1326 / 533) / 1326);
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(533 * var(--u));
  }
  /* the "21-DAY DELIVERY" lockup is the designer's SVG (538 × 248); each letterform is its own path so it can animate */
  .hd__graphic {
    position: absolute;
    left: calc(127 * var(--u));
    top: calc(119 * var(--u));
    width: calc(538 * var(--u));
    height: calc(248 * var(--u));
  }
  .hd__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hd__copy {
    position: absolute;
    right: calc(57 * var(--u)); /* pinned to the right margin: the text block starts 749u from the left at design width */
    top: calc(206 * var(--u));
    width: calc(520 * var(--u));
    white-space: nowrap;
  }
  .hd__copy p {
    font-size: calc(23 * var(--u));
    line-height: calc(35 * var(--u));
    font-weight: 400;
    color: #9a9a9b;
  }
  .hd__copy p > span {
    display: block; /* the design breaks the paragraph into these three lines */
  }
  .hd__copy .hd__way {
    margin-top: calc(6 * var(--u));
    font-weight: 700;
    font-size: calc(33 * var(--u));
    line-height: calc(40 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #98989a;
  }

  /* ---------- phone: stack instead of scaling the stage ---------- */
  @media (max-width: 860px) {
    .hp,
    .hd {
      container-type: normal;
      height: auto;
      min-height: 0;
    }
    .hp__stage,
    .hd__stage {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      translate: none;
      height: auto;
    }
    .hp__eyebrow {
      position: relative;
      left: auto;
      top: auto;
      padding: 3.5rem 1.25rem 0;
      font-size: 0.75rem;
    }
    .hp__statement {
      position: relative;
      left: auto;
      top: auto;
      padding: 0.9rem 1.25rem 3rem;
      font-size: clamp(1.7rem, 7.4vw, 3rem);
      line-height: 1.1;
      white-space: normal;
    }
    .hp__factory {
      position: relative;
      top: auto;
      height: auto;
      aspect-ratio: 1326 / 515;
    }
    .hd__stage {
      padding: 3rem 0 3.5rem;
    }
    .hd__graphic {
      position: relative;
      left: auto;
      top: auto;
      width: min(80vw, 22rem);
      height: auto;
      aspect-ratio: 538 / 248;
      margin: 0 1.25rem;
    }
    .hd__copy {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      width: auto;
      white-space: normal;
      margin: 2.5rem 1.25rem 0;
    }
    .hd__copy p {
      font-size: 1.1rem;
      line-height: 1.55;
    }
    .hd__copy p > span {
      display: inline;
    }
    .hd__copy .hd__way {
      font-size: 1.4rem;
      line-height: 1.3;
    }
  }
</style>
