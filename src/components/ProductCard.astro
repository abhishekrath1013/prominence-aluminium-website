---
// A product card — photograph on top, name in Poppins, three headline specs as small glass tiles.
import { Image } from "astro:assets";
import type { Product } from "../data/products";

interface Props {
  product: Product;
  index?: number;
}
const { product, index } = Astro.props;
const chips = [product.frame[0], product.glazing[0], product.performance[0]].filter(Boolean);
---

<a href={`/${product.slug}/`} class="pc pg-glass" data-reveal="up">
  <div class="pc__media">
    <Image
      src={product.cardImage}
      alt={`${product.fullTitle} — ${product.headline}`}
      class="pc__img"
      loading="lazy"
      widths={[500, 900, 1400]}
      sizes="(min-width: 900px) 46vw, 100vw"
    />
    {index !== undefined && <span class="pc__num pg-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
  </div>
  <div class="pc__body">
    <p class="label-eyebrow text-champagne">{product.category}</p>
    <h3 class="pc__name">{product.name}</h3>
    <p class="pc__headline">{product.headline}</p>
    <ul class="pc__chips">
      {
        chips.map((c) => (
          <li>
            <span>{c.label}</span>
            <strong>{c.value}</strong>
          </li>
        ))
      }
    </ul>
    <span class="pc__more label-eyebrow">
      Discover
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1" /></svg>
    </span>
  </div>
</a>

<style is:global>
  .pc {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.6s var(--ease-lux), background-color 0.4s ease;
  }
  .pc:hover {
    transform: translateY(-6px);
    background: rgb(14 14 16 / 0.85);
  }
  .pc__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .pc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-lux);
  }
  .pc:hover .pc__img {
    transform: scale(1.05);
  }
  .pc__num {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.55);
  }
  .pc__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.75rem 1.75rem 1.9rem;
  }
  .pc__name {
    margin-top: 0.9rem;
    font-family: var(--font-poppins);
    font-weight: 600;
    font-size: clamp(1.7rem, 2.4vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: #f3f3f3;
  }
  .pc__headline {
    margin-top: 0.8rem;
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.6);
  }
  .pc__chips {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .pc__chips li {
    padding: 0.8rem 0.8rem 0.9rem;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.07);
  }
  .pc__chips span {
    display: block;
    font-size: 0.66rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.45);
  }
  .pc__chips strong {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-poppins);
    font-weight: 400;
    font-size: 0.95rem;
    color: #fff;
  }
  .pc__more {
    margin-top: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-champagne);
  }
  .pc__more svg {
    transition: transform 0.5s var(--ease-lux);
  }
  .pc:hover .pc__more svg {
    transform: translateX(4px);
  }
</style>
