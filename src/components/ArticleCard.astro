---
// A Journal article card — the homepage's glass card with a photograph on top.
import { Image } from "astro:assets";
import { images } from "../assets/images";
import type { Insight } from "../data/insights";

interface Props {
  post: Insight;
  /** wide, image-left layout used for the lead article */
  feature?: boolean;
}
const { post, feature = false } = Astro.props;
---

<a href={`/insights/${post.slug}/`} class:list={["ac", "pg-glass", feature && "ac--feature"]} data-reveal="up">
  <div class="ac__media">
    <Image src={images[post.image]} alt="" class="ac__img" loading="lazy" widths={[500, 900, 1400]} sizes={feature ? "(min-width: 900px) 55vw, 100vw" : "(min-width: 900px) 33vw, 100vw"} />
  </div>
  <div class="ac__body">
    <p class="label-eyebrow text-champagne">{post.category}</p>
    <h3 class="ac__title">{post.title}</h3>
    <p class="ac__excerpt">{post.excerpt}</p>
    <div class="ac__meta">
      <span>{post.author} · {post.date}</span>
      <span>{post.readMinutes} min read</span>
    </div>
    <span class="ac__more label-eyebrow">
      Read the article
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1" /></svg>
    </span>
  </div>
</a>

<style is:global>
  .ac {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.6s var(--ease-lux), background-color 0.4s ease;
  }
  .ac:hover {
    transform: translateY(-6px);
    background: rgb(14 14 16 / 0.85);
  }
  .ac__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .ac__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-lux);
  }
  .ac:hover .ac__img {
    transform: scale(1.05);
  }
  .ac__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.75rem 1.75rem 1.9rem;
  }
  .ac__title {
    margin-top: 1rem;
    font-family: var(--font-poppins);
    font-weight: 500;
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: #f3f3f3;
    text-wrap: balance;
  }
  .ac__excerpt {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.55);
  }
  .ac__meta {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.4);
  }
  .ac__more {
    margin-top: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-champagne);
  }
  .ac__more svg {
    transition: transform 0.5s var(--ease-lux);
  }
  .ac:hover .ac__more svg {
    transform: translateX(4px);
  }
  @media (min-width: 900px) {
    .ac--feature {
      flex-direction: row;
    }
    .ac--feature .ac__media {
      flex: 0 0 56%;
      aspect-ratio: auto;
      min-height: 26rem;
    }
    .ac--feature .ac__body {
      justify-content: center;
      padding: 3rem 3rem 3rem 3.2rem;
    }
    .ac--feature .ac__title {
      font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    }
    .ac--feature .ac__excerpt {
      font-size: 1.05rem;
    }
  }
</style>
