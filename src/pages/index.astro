---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import WindowStory from "../sections/WindowStory.astro";
import BrandStatement from "../sections/BrandStatement.astro";
import Configurator from "../sections/Configurator.astro";
import Material from "../sections/Material.astro";
import ProductCollection from "../sections/ProductCollection.astro";
import ArchitecturalSolutions from "../sections/ArchitecturalSolutions.astro";
import Projects from "../sections/Projects.astro";
import ProofCatalogue from "../sections/ProofCatalogue.astro";
import InsightsPreview from "../sections/InsightsPreview.astro";
import ContactCTA from "../sections/ContactCTA.astro";
---

<BaseLayout
  title="PROMINANCE — Precision-Engineered Aluminium Window & Door Systems"
  description="PROMINANCE crafts precision-engineered aluminium window, door and facade systems in 6063 T-6 virgin aluminium — built for architects who specify to the millimetre, so the frame disappears and the architecture begins."
  path="/"
  headerTheme="dark"
>
  <Hero />
  <WindowStory />
  <BrandStatement />
  <Configurator />
  <Material />
  <ProductCollection />
  <ArchitecturalSolutions />
  <Projects />
  <ProofCatalogue />
  <InsightsPreview />
  <ContactCTA />
</BaseLayout>
