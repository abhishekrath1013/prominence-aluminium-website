---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { images } from "../assets/images";
import Eyebrow from "../components/Eyebrow.astro";
import ContactForm from "../components/ContactForm.astro";
import { addOns } from "../data/company";
---

<BaseLayout
  title="Fabricators — Partner With Prominance"
  description="Join Prominance's fabricator network — miter-cut frames, corner cleats, effective drainage and EPDM gaskets, engineered to international standards."
  path="/fabricators/"
  ogImage="/media/full-view.png"
>
  <PageHero eyebrow="Trade — Fabricators" image={images.fullView} imageAlt="A modern white villa with expansive aluminium-framed glazing, representing fabricated architectural systems.">
    Crafting the future of fenestration.
    <Fragment slot="description">
      A comprehensive range of meticulously designed systems, built from premium aluminium profiles and
      manufactured to international standards.
    </Fragment>
  </PageHero>

  <section class="bg-off-white py-24 md:py-36" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <Eyebrow index="01" class="text-ink/65" data-reveal="fade">Built for Fabrication</Eyebrow>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-2xl font-display text-2xl leading-snug text-ink md:text-3xl" data-reveal="up">
          Miter-cut frames, corner cleats, effective drainage and EPDM gaskets — engineered for durability
          in harsh conditions.
        </p>
        <p class="mt-8 max-w-xl text-sm leading-relaxed text-ink/60" data-reveal="up">
          Every Prominance system is designed for consistent, repeatable fabrication, with hardware and gaskets
          tested and warrantied across the full product range.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ink py-24 text-off-white md:py-36" data-reveal-group>
    <div class="container-frame">
      <Eyebrow index="02" class="text-aluminium" data-reveal="fade">Add-Ons</Eyebrow>
      <h2 class="mt-6 max-w-xl font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] text-balance" data-reveal="up">
        Integrations available across the range.
      </h2>
      <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {addOns.map((a) => (
          <div data-reveal="up" class="border-t border-off-white/15 pt-6">
            <p class="font-display text-xl">{a.name}</p>
            <p class="mt-3 text-sm leading-relaxed text-stone">{a.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-off-white py-24 md:py-36" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <Eyebrow index="03" class="text-ink/65" data-reveal="fade">Partner With Us</Eyebrow>
        <h2 class="mt-6 font-display text-[clamp(2rem,4vw,3rem)] leading-[1.08] text-ink text-balance" data-reveal="up">
          Join the Prominance fabricator network.
        </h2>
      </div>
      <div class="md:col-span-7" data-reveal="up">
        <ContactForm tone="light" />
      </div>
    </div>
  </section>
</BaseLayout>
