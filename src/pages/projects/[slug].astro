---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Frame from "../../components/Frame.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import { projects } from "../../data/projects";
import { getProduct } from "../../data/products";
import { getSolution } from "../../data/solutions";
import { images } from "../../assets/images";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const product = getProduct(project.system);
const solution = product ? undefined : getSolution(project.system);
const applications = product?.applications ?? solution?.description ?? "";
const systemHref = product ? `/${product.slug}/` : "/facade-sky-lights/";
const systemHeadline = product?.headline ?? solution?.headline ?? "";
---

<BaseLayout
  title={`${project.title} — Prominance Applications`}
  description={`${project.title}, featuring the Prominance ${project.systemName} system.`}
  path={`/projects/${project.slug}/`}
  ogImage={project.image.src}
>
  <section class="relative h-[85svh] min-h-[520px] w-full overflow-hidden bg-ink" data-reveal-group>
    <Image
      src={project.image}
      alt={`${project.title} — featuring the ${project.systemName} system.`}
      class="h-full w-full object-cover"
      fetchpriority="high"
      widths={[640, 1200, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/10 to-ink/50"></div>
    <div class="pointer-events-none absolute inset-3 md:inset-6"><Frame tone="off-white" /></div>

    <div class="container-frame absolute inset-x-0 bottom-16 md:bottom-20">
      <p class="label-eyebrow text-off-white/70" data-reveal="fade">{project.systemName}</p>
      <h1 class="mt-5 font-display text-[clamp(2.75rem,7.5vw,5.5rem)] leading-[0.98] text-off-white text-balance" data-reveal="up">
        {project.title}
      </h1>
    </div>
  </section>

  <section class="bg-off-white py-20 md:py-28" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12">
      <div class="md:col-span-4">
        <Eyebrow index="01" class="text-ink/65" data-reveal="fade">The Setting</Eyebrow>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-2xl font-display text-2xl leading-snug text-ink md:text-3xl" data-reveal="up">
          {systemHeadline}
        </p>
        <p class="mt-8 max-w-xl text-sm leading-relaxed text-ink/60" data-reveal="up">
          {applications}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-off-white pb-20 md:pb-28" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="uf-frame-host relative" data-reveal="up">
        <div class="relative aspect-[4/3] w-full overflow-hidden">
          <Image
            src={project.image}
            alt={`${project.title} detail crop.`}
            class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.02]"
            loading="lazy"
            widths={[400, 800, 1200]}
            sizes="(min-width: 640px) 50vw, 100vw"
          />
        </div>
        <Frame hover />
      </div>
      <div class="uf-frame-host relative" data-reveal="up">
        <div class="relative aspect-[4/3] w-full overflow-hidden">
          <Image
            src={images.led}
            alt="Macro detail of an aluminium frame reveal with integrated LED lighting."
            class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.02]"
            loading="lazy"
            widths={[400, 800, 1200]}
            sizes="(min-width: 640px) 50vw, 100vw"
          />
        </div>
        <Frame hover />
      </div>
    </div>
  </section>

  <section class="bg-ink py-20 text-off-white md:py-28" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12">
      <div class="md:col-span-4">
        <Eyebrow index="02" class="text-aluminium" data-reveal="fade">The System</Eyebrow>
      </div>
      <div class="md:col-span-8">
        <h2 class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1.08] text-balance" data-reveal="up">
          {project.systemName}
        </h2>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-stone" data-reveal="up">
          {product?.description ?? solution?.description}
        </p>
        <div class="mt-8" data-reveal="up">
          <ArrowLink href={systemHref} variant="light">View {project.systemName}</ArrowLink>
        </div>
      </div>
    </div>
  </section>

  <section class="relative h-[70svh] min-h-[420px] w-full overflow-hidden" data-reveal-group>
    <Image
      src={project.image}
      alt={project.title}
      class="h-full w-full object-cover"
      loading="lazy"
      widths={[640, 1200, 1920]}
      sizes="100vw"
    />
  </section>
</BaseLayout>
