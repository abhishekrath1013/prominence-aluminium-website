---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { images } from "../../assets/images";
import Frame from "../../components/Frame.astro";
import ContactCTA from "../../sections/ContactCTA.astro";
import { projects } from "../../data/projects";
---

<BaseLayout
  title="Projects — Prominance Systems in Architectural Context"
  description="Selected applications of Prominance's aluminium window, door and facade systems across residential and architectural settings."
  path="/projects/"
  ogImage="/media/hero-corner.jpg"
>
  <PageHero eyebrow="Applications" image={images.heroCorner} imageAlt="A concrete villa corner with full-height aluminium-framed glazing opening onto a terrace.">
    Applications
    <Fragment slot="description">
      A closer look at how each Prominance system performs in real architectural settings — from panoramic
      hillside glazing to compact urban interiors.
    </Fragment>
  </PageHero>

  <section class="bg-off-white py-16 md:py-24" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        projects.map((project, i) => (
          <a
            href={`/projects/${project.slug}/`}
            class:list={["uf-frame-host group relative block overflow-hidden", i === 0 && "sm:col-span-2"]}
            data-reveal="up"
            data-cursor-hover
          >
            <div class:list={["relative w-full overflow-hidden", i === 0 ? "aspect-[16/9]" : "aspect-[4/3]"]}>
              <Image
                src={project.image}
                alt={`${project.title} — featuring the ${project.systemName} system.`}
                class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.02]"
                loading="lazy"
                widths={[400, 800, 1200]}
                sizes="(min-width: 640px) 50vw, 100vw"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent opacity-0 transition-precise group-hover:opacity-100" />
              <Frame tone="off-white" hover />
              <div class="absolute inset-x-6 bottom-6 flex translate-y-2 items-end justify-between opacity-0 transition-precise group-hover:translate-y-0 group-hover:opacity-100">
                <div>
                  <p class="label-eyebrow text-off-white/70">{project.systemName}</p>
                  <p class="mt-2 font-display text-xl text-off-white md:text-2xl">{project.title}</p>
                </div>
                <svg width="20" height="12" viewBox="0 0 18 10" fill="none" class="text-off-white">
                  <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1" />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
