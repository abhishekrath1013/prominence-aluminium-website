---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ContactForm from "../components/ContactForm.astro";
import { company } from "../data/company";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(company.mapAddress)}&output=embed`;
---

<BaseLayout
  title="Contact Prominance"
  description="Get in touch with Prominance — 1800 102 106, enquiry@uniframe.com, or visit our facility in Coimbatore, Tamil Nadu."
  path="/contact-us/"
  headerTheme="light"
>
  <section class="bg-off-white pb-8 pt-40 md:pt-48" data-reveal-group>
    <div class="container-frame">
      <Eyebrow index="01" class="text-ink/65" data-reveal="fade">Contact</Eyebrow>
      <h1 class="mt-6 max-w-3xl font-display text-[clamp(2.5rem,7vw,5.5rem)] leading-[0.98] text-ink text-balance" data-reveal="up">
        Let’s frame <span class="italic text-ink/45">your next space.</span>
      </h1>
      <p class="mt-8 max-w-lg text-base leading-relaxed text-ink/60" data-reveal="up">
        Whether you’re specifying a residential project, planning a facade, or exploring a fabrication
        partnership — our team is ready to help.
      </p>
    </div>
  </section>

  <section class="bg-off-white py-14 md:py-20" data-reveal-group>
    <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex flex-col gap-10">
          <div data-reveal="up">
            <p class="label-eyebrow text-ink/60">Toll Free</p>
            <a href={company.phoneHref} class="mt-2 block font-display text-2xl text-ink hover:opacity-60 transition-precise">{company.phoneDisplay}</a>
          </div>
          <div data-reveal="up">
            <p class="label-eyebrow text-ink/60">Email</p>
            <a href={`mailto:${company.email}`} class="mt-2 block font-display text-2xl text-ink hover:opacity-60 transition-precise">{company.email}</a>
          </div>
          <div data-reveal="up">
            <p class="label-eyebrow text-ink/60">Factory &amp; Registered Office</p>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink/70">
              {company.legalName}<br />
              {company.addressLine1}<br />
              {company.addressLine2}
            </p>
          </div>
        </div>

        <div class="uf-frame-host relative mt-12 aspect-[4/3] w-full overflow-hidden border border-ink/10" data-reveal="up">
          <iframe
            src={mapSrc}
            title="Prominance facility location on Google Maps"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full w-full grayscale contrast-125"
          ></iframe>
        </div>
      </div>

      <div class="md:col-span-7" data-reveal="up">
        <ContactForm tone="light" />
      </div>
    </div>
  </section>
</BaseLayout>
