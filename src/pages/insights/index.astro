---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { insights } from "../../data/insights";
import ContactCTA from "../../sections/ContactCTA.astro";
---

<BaseLayout
  title="Insights — Notes on Material, Performance & Design"
  description="Prominance Insights: articles on aluminium window durability, quality and casement window types."
  path="/insights/"
  headerTheme="light"
>
  <section class="bg-off-white pb-8 pt-40 md:pt-48" data-reveal-group>
    <div class="container-frame">
      <Eyebrow index="01" class="text-ink/65" data-reveal="fade">Insights</Eyebrow>
      <h1 class="mt-6 max-w-3xl font-display text-[clamp(2.5rem,7vw,5.5rem)] leading-[0.98] text-ink text-balance" data-reveal="up">
        Notes on material, <span class="italic text-ink/45">performance and design.</span>
      </h1>
    </div>
  </section>

  <section class="bg-off-white py-14 md:py-20" data-reveal-group>
    <div class="container-frame flex flex-col">
      {
        insights.map((post) => (
          <a
            href={post.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col gap-3 border-t border-ink/10 py-10 transition-precise hover:bg-ink/[0.02] md:flex-row md:items-center md:justify-between md:px-2"
            data-reveal="up"
            data-cursor-hover
          >
            <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-10">
              <span class="label-eyebrow text-ink/60">{post.category}</span>
              <p class="font-display text-2xl leading-snug text-ink md:text-3xl">{post.title}</p>
            </div>
            <div class="flex items-center gap-6 text-xs text-ink/65">
              <span>{post.author} · {post.date}</span>
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="text-ink transition-precise group-hover:translate-x-1">
                <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
              </svg>
            </div>
          </a>
        ))
      }
      <div class="border-t border-ink/10"></div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
