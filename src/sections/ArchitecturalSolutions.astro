---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import Frame from "../components/Frame.astro";
import { solutions } from "../data/solutions";

const shapes = [
  { name: "Triangle", points: "12,2 22,20 2,20" },
  { name: "Square", points: "3,3 21,3 21,21 3,21" },
  { name: "Pentagon", points: "12,1 22,9 18,21 6,21 2,9" },
  { name: "Hexagon", points: "6,2 18,2 23,12 18,22 6,22 1,12" },
  { name: "Heptagon", points: "12,1 19,4 22,11 18,19 6,19 2,11 5,4" },
  { name: "Octagon", points: "7,2 17,2 22,7 22,17 17,22 7,22 2,17 2,7" },
] as const;
---

<section class="relative overflow-hidden bg-ink py-24 text-off-white md:py-36" data-reveal-group>
  <span class="uf-numeral left-0 text-off-white" aria-hidden="true">06</span>

  <div class="container-frame relative">
    <Eyebrow index="06" class="text-aluminium" data-reveal="fade">For Architects</Eyebrow>
    <h2 class="mt-6 max-w-2xl font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] text-balance" data-reveal="up">
      Beyond the window — systems for the whole elevation.
    </h2>
    <p class="mt-6 max-w-lg text-sm leading-relaxed text-stone" data-reveal="up">
      Every non-standard opening — angular, arched, corner or full-height — is engineered case-by-case on the
      same 6063 T-6 platform, with drawings ready for your specification.
    </p>

    <div class="mt-12 flex flex-wrap gap-x-10 gap-y-6" data-reveal="up">
      {
        shapes.map((shape) => (
          <div class="flex flex-col items-center gap-3 text-aluminium">
            <svg width="26" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <polygon points={shape.points} fill="none" stroke="currentColor" stroke-width="1.2" />
            </svg>
            <span class="text-[0.65rem] uppercase tracking-[0.14em] text-stone">{shape.name}</span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="container-frame mt-16 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2 lg:gap-4">
    {
      solutions.map((solution, i) => (
        <a
          href={`/facade-sky-lights/#${solution.slug}`}
          class:list={[
            "uf-frame-host group relative flex flex-col justify-end overflow-hidden bg-ink-soft p-8 md:p-10",
            i === 0 ? "min-h-[26rem] lg:col-span-2 lg:row-span-2" : "min-h-[16rem] lg:col-span-2 lg:row-span-1",
          ]}
          data-reveal="up"
          data-cursor-hover
        >
          <Image
            src={solution.image}
            alt={solution.headline}
            class="absolute inset-0 h-full w-full object-cover opacity-60 transition-precise duration-[1200ms] group-hover:scale-[1.02] group-hover:opacity-75"
            loading="lazy"
            widths={[300, 600, 900]}
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
          <Frame tone="off-white" hover />
          <div class="relative">
            <h3 class:list={["font-display", i === 0 ? "text-3xl md:text-4xl" : "text-2xl md:text-3xl"]}>{solution.name}</h3>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-stone">{solution.headline}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
