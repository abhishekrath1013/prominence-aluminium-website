---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import Frame from "../components/Frame.astro";
import { solutions } from "../data/solutions";
---

<section class="relative overflow-hidden bg-ink py-16 text-off-white md:py-24" data-reveal-group>
  <div class="container-frame relative">
    <Eyebrow index="06" class="text-aluminium" data-reveal="fade">For Architects</Eyebrow>
    <h2 class="mt-6 max-w-2xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-balance" data-reveal="up">
      Beyond the window — systems for the whole elevation.
    </h2>
    <p class="mt-6 max-w-lg text-sm leading-relaxed text-stone" data-reveal="up">
      Every non-standard opening — angular, arched, corner or full-height — is engineered case-by-case on the
      same 6063 T-6 platform, with drawings ready for your specification.
    </p>
  </div>

  <div class="container-frame mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-rows-2">
    {
      solutions.map((solution) => (
        <a
          href={`/facade-sky-lights/#${solution.slug}`}
          class="uf-frame-host group relative flex min-h-[20rem] flex-col justify-end overflow-hidden bg-ink-soft p-8 md:p-10 lg:min-h-[22rem]"
          data-reveal="up"
          data-cursor-hover
        >
          <Image
            src={solution.image}
            alt={solution.headline}
            class="absolute inset-0 h-full w-full object-cover opacity-60 transition-precise duration-[1200ms] group-hover:scale-[1.02] group-hover:opacity-75"
            loading="lazy"
            widths={[300, 600, 900]}
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
          <Frame tone="off-white" hover />
          <div class="relative">
            <h3 class="font-display text-2xl md:text-3xl">{solution.name}</h3>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-stone">{solution.headline}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
