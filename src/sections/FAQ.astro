---
import Eyebrow from "../components/Eyebrow.astro";

const faqs = [
  {
    q: "What aluminium do Prominance systems use?",
    a: "Every profile is extruded from 6063 T-6 virgin aluminium, chosen for its structural integrity and corrosion-resistant surface — never recycled or secondary-grade material.",
  },
  {
    q: "What warranty comes with a Prominance system?",
    a: "A 25-year warranty against surface corrosion, covering the finish, gaskets and hardware performance across every system we manufacture.",
  },
  {
    q: "How many finishes and colours can I choose from?",
    a: "Over 100 anodised, powder-coated and metallic finishes — the same range shown in the Shades & Finishes section of our Products page.",
  },
  {
    q: "Do you work with fabricators, or only direct?",
    a: "Both. We manufacture systems supplied through our fabricator network, and work directly with architects and project teams who specify to the millimetre.",
  },
  {
    q: "Can a system be customised for a non-standard opening?",
    a: "Yes — angular, arched, corner and full-height openings are engineered case-by-case on the same 6063 T-6 platform, with drawings prepared for your specification.",
  },
  {
    q: "How do I get a quote for my project?",
    a: "Use the Get a Quote button at the top of this page, or reach us directly — every enquiry goes straight to our specification team.",
  },
] as const;
---

<section class="bg-off-white py-24 md:py-32" data-reveal-group>
  <div class="container-frame">
    <Eyebrow class="text-ink/65" data-reveal="fade">FAQ</Eyebrow>
    <h2 class="mt-6 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-ink text-balance" data-reveal="up">
      Common questions, answered plainly.
    </h2>
  </div>

  <div class="container-frame mt-14 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5" data-reveal="up">
    {
      faqs.map((item) => (
        <div class="uf-faq-item group relative border border-ink/10 bg-off-white p-6 transition-precise hover:-translate-y-1 hover:border-brass/40" data-faq-item>
          <button type="button" class="uf-faq-trigger" aria-expanded="false" data-faq-trigger>
            <span class="font-display text-lg text-ink transition-precise group-hover:text-brass md:text-xl">{item.q}</span>
            <span class="uf-faq-plus" aria-hidden="true"></span>
          </button>
          <div class="uf-faq-panel" data-faq-panel>
            <p class="pb-1 pt-2 text-sm leading-relaxed text-ink/60">{item.a}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .uf-faq-item {
    box-shadow: 0 0 0 rgb(11 26 38 / 0);
    transition: transform var(--duration-normal) var(--ease-precise), border-color var(--duration-normal) var(--ease-precise), box-shadow var(--duration-normal) var(--ease-precise);
  }

  .uf-faq-item:hover {
    box-shadow: 0 20px 40px -28px rgb(11 26 38 / 0.35);
  }

  .uf-faq-trigger {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-align: left;
    cursor: pointer;
  }

  .uf-faq-plus {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .uf-faq-plus::before,
  .uf-faq-plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-ink);
    transition: transform var(--duration-normal) var(--ease-precise), background var(--duration-normal) var(--ease-precise);
  }

  .group:hover .uf-faq-plus::before,
  .group:hover .uf-faq-plus::after {
    background: var(--color-brass);
  }

  .uf-faq-plus::before {
    width: 18px;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .uf-faq-plus::after {
    width: 1.5px;
    height: 18px;
    transform: translate(-50%, -50%);
  }

  .uf-faq-trigger[aria-expanded="true"] .uf-faq-plus::after {
    transform: translate(-50%, -50%) rotate(90deg) scale(0);
  }

  .uf-faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows var(--duration-normal) var(--ease-precise);
  }

  .uf-faq-panel > p {
    min-height: 0;
    overflow: hidden;
  }

  .uf-faq-item[data-open="true"] .uf-faq-panel {
    grid-template-rows: 1fr;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq-item]").forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
    trigger?.addEventListener("click", () => {
      const isOpen = item.dataset.open === "true";
      item.dataset.open = String(!isOpen);
      trigger.setAttribute("aria-expanded", String(!isOpen));
    });
  });
</script>
