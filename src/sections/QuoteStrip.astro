---
import { company } from "../data/company";
---

<section class="border-y border-brass/25 bg-brass-soft/25">
  <div class="container-frame flex flex-col items-center justify-between gap-5 py-7 text-center md:flex-row md:text-left">
    <p class="font-display text-xl text-ink md:text-2xl">Ready to specify your next project?</p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href={company.phoneHref}
        class="inline-flex items-center gap-2 rounded-full border border-ink/30 px-6 py-3 text-sm font-semibold text-ink transition-precise hover:border-ink hover:bg-ink hover:text-off-white"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.2 2.2z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
        {company.phoneDisplay}
      </a>
      <a
        href="/contact-us/"
        class="inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-white transition-precise hover:bg-ink"
      >
        Get a Quote
      </a>
    </div>
  </div>
</section>
