---
import Eyebrow from "../components/Eyebrow.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { insights } from "../data/insights";
---

<section class="bg-ink py-24 text-off-white md:py-36" data-reveal-group>
  <div class="container-frame">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow index="09" class="text-aluminium" data-reveal="fade">Insights</Eyebrow>
        <h2 class="mt-6 max-w-xl font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] text-balance" data-reveal="up">
          Notes on material, performance and design.
        </h2>
      </div>
      <div data-reveal="up">
        <ArrowLink href="/insights/" variant="light">View All Insights</ArrowLink>
      </div>
    </div>

    <div class="mt-16 flex flex-col" data-reveal="up">
      {
        insights.map((post) => (
          <a
            href={post.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col gap-3 border-t border-off-white/15 py-8 transition-precise hover:bg-off-white/[0.03] md:flex-row md:items-center md:justify-between md:px-4"
            data-cursor-hover
          >
            <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-8">
              <span class="label-eyebrow text-aluminium">{post.category}</span>
              <p class="font-display text-xl leading-snug text-off-white md:text-2xl">{post.title}</p>
            </div>
            <div class="flex items-center gap-6 text-xs text-stone">
              <span>{post.date}</span>
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="transition-precise group-hover:translate-x-1">
                <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
