---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import Frame from "../components/Frame.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { finishes, finishTiers, type FinishTier } from "../data/finishes";
import { getProduct } from "../data/products";
import { images } from "../assets/images";

const typologies = [
  { key: "sliding", productSlug: "graf-45", label: "Sliding" },
  { key: "corner", productSlug: "graf-73", label: "Panoramic Corner" },
  { key: "casement", productSlug: "livio", label: "Casement" },
  { key: "foldslide", productSlug: "robus-40", label: "Fold & Slide" },
] as const;

const stages = typologies.map((t) => ({ ...t, product: getProduct(t.productSlug)! }));
const tiers: FinishTier[] = ["natural", "solid", "premium"];
const defaultFinish = finishes.find((f) => f.slug === "noir") ?? finishes[0];
---

<section class="uf-config relative flex min-h-screen flex-col justify-center overflow-hidden bg-ink py-14 text-off-white" data-reveal-group>
  <div class="container-frame relative">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow class="text-aluminium" data-reveal="fade">The Atelier</Eyebrow>
        <h2 class="mt-4 max-w-2xl font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.08] text-balance" data-reveal="up">
          Design your view, in real time.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-stone" data-reveal="up">
        Select a system and a finish exactly as you would specify one on a drawing — every combination below
        is a real Prominance system and a real Prominance colour.
      </p>
    </div>
  </div>

  <div class="container-frame mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10" data-reveal="up">
    <!-- Stage -->
    <div class="uf-config-stage-host uf-frame-host relative lg:col-span-7" style={`--uf-cfg-color:${defaultFinish.swatch}`}>
      <div class="uf-config-stage relative flex aspect-[4/5] items-center justify-center overflow-hidden sm:aspect-[16/11] lg:h-full lg:aspect-auto lg:max-h-[52vh]">
        <Image
          src={images.lifestyleSofaGlasswall}
          alt=""
          aria-hidden="true"
          class="uf-config-backdrop absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          widths={[640, 1000, 1400]}
          sizes="(min-width: 1024px) 45vw, 100vw"
        />
        <div class="uf-config-glow" aria-hidden="true"></div>

        {
          stages.map((s, i) => (
            <svg
              class="uf-config-art"
              data-stage={s.key}
              data-active={i === 0 ? "true" : "false"}
              viewBox="0 0 320 420"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id={`glass-${s.key}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#eef3f6" stop-opacity="0.9" />
                  <stop offset="55%" stop-color="#c7d3da" stop-opacity="0.55" />
                  <stop offset="100%" stop-color="#eef3f6" stop-opacity="0.85" />
                </linearGradient>
              </defs>

              {/* ---- SLIDING (Graf 45) ---- */}
              {s.key === "sliding" && (
                <g>
                  <rect x="14" y="14" width="138" height="392" fill={`url(#glass-${s.key})`} />
                  <g class="uf-cfg-sash" style="--slide-x:-134px">
                    <rect x="168" y="14" width="138" height="392" fill={`url(#glass-${s.key})`} />
                    <line x1="168" y1="80" x2="306" y2="14" stroke="#ffffff" stroke-opacity="0.35" stroke-width="2" />
                  </g>
                  <line x1="14" y1="80" x2="152" y2="14" stroke="#ffffff" stroke-opacity="0.4" stroke-width="2" />
                  <path
                    class="uf-cfg-frame"
                    fill-rule="evenodd"
                    d="M0,0 H320 V420 H0 Z M14,14 V406 H306 V14 Z M152,14 H168 V406 H152 Z"
                  />
                  <circle cx="160" cy="210" r="17" fill="#f4f1ea" opacity="0.92" />
                  <path d="M146,210 H174 M153,203 L146,210 L153,217 M167,203 L174,210 L167,217" stroke="#171613" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="160" y1="130" x2="160" y2="150" stroke="#171613" stroke-width="1" stroke-dasharray="2 3" opacity="0.4" />
                  <line x1="160" y1="270" x2="160" y2="290" stroke="#171613" stroke-width="1" stroke-dasharray="2 3" opacity="0.4" />
                </g>
              )}

              {/* ---- PANORAMIC CORNER (Graf 73) ---- */}
              {s.key === "corner" && (
                <g>
                  <g class="uf-cfg-sash" style="--slide-x:-96px">
                    <rect x="14" y="14" width="292" height="392" fill={`url(#glass-${s.key})`} />
                    <line x1="14" y1="120" x2="150" y2="14" stroke="#ffffff" stroke-opacity="0.4" stroke-width="2" />
                  </g>
                  <path
                    class="uf-cfg-frame"
                    fill-rule="evenodd"
                    d="M0,0 H320 V420 H0 Z M14,14 V406 H306 V14 Z M250,14 H262 V406 H250 Z"
                  />
                  <g transform="translate(258,34)" opacity="0.85">
                    <path d="M0,20 V0 H26" fill="none" stroke="#171613" stroke-width="1.4" />
                    <path d="M2,20 V4 H26" fill="none" stroke="#171613" stroke-width="1.4" />
                  </g>
                  <text x="204" y="30" class="uf-cfg-label-mini">GLASS-TO-GLASS JOINT</text>
                  <path d="M40,210 H90 M78,202 L90,210 L78,218" stroke="#171613" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.75" />
                </g>
              )}

              {/* ---- CASEMENT (Livio) ---- */}
              {s.key === "casement" && (
                <g>
                  <g class="uf-cfg-swing uf-cfg-swing--left">
                    <rect x="14" y="14" width="140" height="392" fill={`url(#glass-${s.key})`} />
                    <line x1="14" y1="80" x2="154" y2="14" stroke="#ffffff" stroke-opacity="0.4" stroke-width="2" />
                  </g>
                  <g class="uf-cfg-swing uf-cfg-swing--right">
                    <rect x="166" y="14" width="140" height="392" fill={`url(#glass-${s.key})`} />
                    <line x1="166" y1="80" x2="306" y2="14" stroke="#ffffff" stroke-opacity="0.35" stroke-width="2" />
                  </g>
                  <path d="M14,406 L84,210" stroke="#171613" stroke-width="1" stroke-dasharray="3 4" opacity="0.55" fill="none" />
                  <path d="M306,406 L236,210" stroke="#171613" stroke-width="1" stroke-dasharray="3 4" opacity="0.55" fill="none" />
                  <path
                    class="uf-cfg-frame"
                    fill-rule="evenodd"
                    d="M0,0 H320 V420 H0 Z M14,14 V406 H306 V14 Z M154,14 H166 V406 H154 Z"
                  />
                  <rect x="140" y="200" width="10" height="20" rx="2" fill="#171613" opacity="0.85" />
                  <rect x="170" y="200" width="10" height="20" rx="2" fill="#171613" opacity="0.85" />
                </g>
              )}

              {/* ---- FOLD & SLIDE (Robus 40) ---- */}
              {s.key === "foldslide" && (
                <g>
                  <rect x="14" y="14" width="67" height="392" fill={`url(#glass-${s.key})`} />
                  <g class="uf-cfg-sash" style="--slide-x:-67px">
                    <rect x="89" y="14" width="67" height="392" fill={`url(#glass-${s.key})`} />
                  </g>
                  <g class="uf-cfg-sash" style="--slide-x:-134px">
                    <rect x="164" y="14" width="67" height="392" fill={`url(#glass-${s.key})`} />
                  </g>
                  <g class="uf-cfg-sash" style="--slide-x:-201px">
                    <rect x="239" y="14" width="67" height="392" fill={`url(#glass-${s.key})`} />
                  </g>
                  <line x1="14" y1="70" x2="81" y2="14" stroke="#ffffff" stroke-opacity="0.35" stroke-width="2" />
                  <path
                    class="uf-cfg-frame"
                    fill-rule="evenodd"
                    d="M0,0 H320 V420 H0 Z M14,14 V406 H306 V14 Z M81,14 H89 V406 H81 Z M156,14 H164 V406 H156 Z M231,14 H239 V406 H231 Z"
                  />
                  <path d="M85,190 L95,200 L85,210" stroke="#171613" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
                  <path d="M160,190 L170,200 L160,210" stroke="#171613" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
                  <path d="M235,190 L245,200 L235,210" stroke="#171613" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
                  <path d="M50,208 L20,208 M28,200 L18,208 L28,216" stroke="#171613" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
                </g>
              )}
            </svg>
          ))
        }
      </div>
      <Frame tone="off-white" />

      <button type="button" class="uf-config-open-toggle absolute right-6 top-6 md:right-8 md:top-8" data-config-open-toggle aria-pressed="false">
        <span class="label-eyebrow" data-config-open-label>View Open</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="uf-config-open-icon">
          <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.3" />
        </svg>
      </button>

      <div class="uf-config-caption absolute inset-x-6 bottom-6 flex flex-wrap items-end justify-between gap-4 md:inset-x-8 md:bottom-8">
        <div>
          <p class="label-eyebrow text-aluminium" data-config-category>{stages[0].product.category}</p>
          <p class="mt-2 font-display text-2xl text-off-white md:text-3xl" data-config-name>{stages[0].product.name}</p>
        </div>
        <div class="text-right">
          <p class="label-eyebrow text-aluminium">Finish</p>
          <p class="mt-2 font-display text-2xl text-off-white md:text-3xl" data-config-finish>{defaultFinish.name}</p>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex flex-col gap-6 lg:col-span-5">
      <div>
        <p class="label-eyebrow text-aluminium">Choose a system</p>
        <div class="mt-4 grid grid-cols-2 gap-2.5" role="radiogroup" aria-label="Select a window system">
          {
            stages.map((s, i) => (
              <button
                type="button"
                class="uf-config-tab group relative flex flex-col items-start gap-2 border border-off-white/15 p-3 text-left transition-precise hover:border-off-white/40"
                data-stage-btn={s.key}
                role="radio"
                aria-checked={i === 0 ? "true" : "false"}
                data-name={s.product.name}
                data-category={s.product.category}
              >
                <svg class="uf-config-tab-icon" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
                  {s.key === "sliding" && (
                    <g stroke="currentColor" stroke-width="1.4" fill="none">
                      <rect x="3" y="4" width="26" height="24" />
                      <line x1="16" y1="4" x2="16" y2="28" />
                      <path d="M10,16 H13 M13,13 L16,16 L13,19" />
                      <path d="M22,16 H19 M19,13 L16,16 L19,19" />
                    </g>
                  )}
                  {s.key === "corner" && (
                    <g stroke="currentColor" stroke-width="1.4" fill="none">
                      <rect x="3" y="4" width="26" height="24" />
                      <line x1="23" y1="4" x2="23" y2="28" />
                      <path d="M23,10 V6 H27" />
                    </g>
                  )}
                  {s.key === "casement" && (
                    <g stroke="currentColor" stroke-width="1.4" fill="none">
                      <rect x="3" y="4" width="26" height="24" />
                      <line x1="16" y1="4" x2="16" y2="28" />
                      <path d="M3,28 L12,16" stroke-dasharray="2 2" />
                      <path d="M29,28 L20,16" stroke-dasharray="2 2" />
                    </g>
                  )}
                  {s.key === "foldslide" && (
                    <g stroke="currentColor" stroke-width="1.4" fill="none">
                      <rect x="3" y="4" width="26" height="24" />
                      <line x1="10" y1="4" x2="10" y2="28" />
                      <line x1="16" y1="4" x2="16" y2="28" />
                      <line x1="22" y1="4" x2="22" y2="28" />
                    </g>
                  )}
                </svg>
                <span>
                  <span class="block font-display text-lg leading-tight">{s.label}</span>
                  <span class="mt-1 block text-xs text-stone">{s.product.name}</span>
                </span>
                <span class="uf-config-tab-ring pointer-events-none absolute inset-0 border transition-precise" aria-hidden="true" />
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="label-eyebrow text-aluminium">Choose a finish</p>
        <div class="mt-4 flex flex-col gap-4">
          {
            tiers.map((tier) => (
              <div>
                <p class="text-xs text-stone">{finishTiers[tier].label}</p>
                <div class="mt-2 flex flex-wrap gap-2.5" role="radiogroup" aria-label={finishTiers[tier].label}>
                  {finishes
                    .filter((f) => f.tier === tier)
                    .map((f) => (
                      <button
                        type="button"
                        class="uf-config-swatch group relative h-8 w-8 rounded-full border border-off-white/20 transition-precise"
                        style={`background-color:${f.swatch}`}
                        data-swatch={f.swatch}
                        data-name={f.name}
                        data-tier={finishTiers[f.tier].label}
                        data-description={f.description}
                        role="radio"
                        aria-checked={f.slug === defaultFinish.slug ? "true" : "false"}
                        aria-label={f.name}
                      >
                        <span class="uf-config-swatch-ring absolute -inset-1.5 rounded-full border transition-precise" />
                      </button>
                    ))}
                </div>
              </div>
            ))
          }
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-stone" data-config-description>{defaultFinish.description}</p>
      </div>

      <div>
        <ArrowLink href="/architects/" variant="light">Request This Specification</ArrowLink>
      </div>
    </div>
  </div>
</section>

<style>
  .uf-config-stage-host {
    background: radial-gradient(120% 100% at 50% 15%, rgb(247 245 240 / 0.06), transparent 60%), var(--color-ink-soft);
  }

  .uf-config-stage {
    background: var(--color-ink-soft);
  }

  /* A real interior scene behind the window line-art, so "designing your
     view" reads as placing a window into an actual room rather than
     floating on a flat colour. Dimmed hard so the stroke art and captions
     stay the legible, primary layer. */
  .uf-config-backdrop {
    z-index: 0;
    opacity: 0.4;
    filter: saturate(0.7) brightness(0.8);
  }

  .uf-config-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgb(11 26 38 / 0.55) 0%, rgb(11 26 38 / 0.25) 40%, rgb(11 26 38 / 0.75) 100%);
    pointer-events: none;
  }

  .uf-config-glow {
    position: absolute;
    inset: 8% 14%;
    z-index: 1;
    background: radial-gradient(closest-side, rgb(247 245 240 / 0.16), transparent 72%);
    filter: blur(6px);
    pointer-events: none;
  }

  /* The "View Open" toggle slides the moving sash(es) of whichever system is
     active — real motion demonstrating how each system actually operates,
     not just a static render. */
  .uf-config-open-toggle {
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid rgb(247 245 240 / 0.3);
    padding: 0.5rem 0.9rem;
    color: var(--color-off-white);
    background: rgb(11 26 38 / 0.35);
    backdrop-filter: blur(6px);
    transition: border-color var(--duration-micro) ease, background var(--duration-micro) ease;
  }

  .uf-config-open-toggle:hover {
    border-color: var(--color-brass-soft);
  }

  .uf-config-open-toggle[aria-pressed="true"] {
    border-color: var(--color-brass-soft);
    background: rgb(31 124 180 / 0.25);
  }

  .uf-config-open-icon {
    transition: transform var(--duration-normal) var(--ease-precise);
  }

  .uf-config-open-toggle[aria-pressed="true"] .uf-config-open-icon {
    transform: rotate(180deg);
  }

  .uf-cfg-sash {
    transform-box: fill-box;
    transition: transform 0.9s var(--ease-precise);
  }

  .uf-config-art[data-open="true"] .uf-cfg-sash {
    transform: translateX(var(--slide-x, 0));
  }

  .uf-cfg-swing {
    transform-box: fill-box;
    transition: transform 0.9s var(--ease-precise);
  }

  .uf-cfg-swing--left {
    transform-origin: left center;
  }

  .uf-cfg-swing--right {
    transform-origin: right center;
  }

  .uf-config-art[data-open="true"] .uf-cfg-swing--left {
    transform: rotateY(0deg) skewY(-6deg) scaleX(0.92) translateX(2px);
  }

  .uf-config-art[data-open="true"] .uf-cfg-swing--right {
    transform: skewY(6deg) scaleX(0.92) translateX(-2px);
  }

  .uf-config-art {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: auto;
    height: 82%;
    width: auto;
    max-width: 90%;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.45));
    transition: opacity var(--duration-normal) var(--ease-precise);
  }

  .uf-config-art[data-active="false"] {
    opacity: 0;
    pointer-events: none;
  }

  .uf-config-art[data-active="true"] {
    opacity: 1;
  }

  .uf-cfg-frame {
    fill: var(--uf-cfg-color, #25272c);
    stroke: rgb(0 0 0 / 0.25);
    stroke-width: 1;
    transition: fill var(--duration-normal) var(--ease-precise);
  }

  .uf-cfg-label-mini {
    font-family: var(--font-sans);
    font-size: 6px;
    font-weight: 600;
    letter-spacing: 0.14em;
    fill: rgb(247 245 240 / 0.55);
  }

  .uf-config-caption {
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.5);
  }

  .uf-config-tab[aria-checked="true"] {
    border-color: var(--color-brass);
    background: rgb(176 141 87 / 0.08);
  }

  .uf-config-tab-ring {
    opacity: 0;
    border-color: var(--color-brass);
  }

  .uf-config-tab[aria-checked="true"] .uf-config-tab-ring {
    opacity: 0.7;
  }

  .uf-config-tab-icon {
    color: var(--color-aluminium);
    transition: color var(--duration-normal) var(--ease-precise);
  }

  .uf-config-tab[aria-checked="true"] .uf-config-tab-icon {
    color: var(--color-off-white);
  }

  .uf-config-swatch-ring {
    opacity: 0;
    border-color: var(--color-brass);
    transform: scale(0.85);
    transition:
      opacity var(--duration-micro) var(--ease-precise),
      transform var(--duration-micro) var(--ease-precise);
  }

  .uf-config-swatch[aria-checked="true"] .uf-config-swatch-ring,
  .uf-config-swatch:hover .uf-config-swatch-ring {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>(".uf-config-stage-host");
  const stageArts = document.querySelectorAll<SVGElement>(".uf-config-art");
  const stageTabs = document.querySelectorAll<HTMLButtonElement>("[data-stage-btn]");
  const swatches = document.querySelectorAll<HTMLButtonElement>(".uf-config-swatch");

  const nameEl = document.querySelector<HTMLElement>("[data-config-name]");
  const categoryEl = document.querySelector<HTMLElement>("[data-config-category]");
  const finishEl = document.querySelector<HTMLElement>("[data-config-finish]");
  const descriptionEl = document.querySelector<HTMLElement>("[data-config-description]");
  const openToggle = document.querySelector<HTMLButtonElement>("[data-config-open-toggle]");
  const openLabel = document.querySelector<HTMLElement>("[data-config-open-label]");

  function closeStage() {
    stageArts.forEach((art) => art.setAttribute("data-open", "false"));
    openToggle?.setAttribute("aria-pressed", "false");
    if (openLabel) openLabel.textContent = "View Open";
  }

  stageTabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.stageBtn;

      stageTabs.forEach((b) => b.setAttribute("aria-checked", "false"));
      btn.setAttribute("aria-checked", "true");

      stageArts.forEach((art) => {
        art.setAttribute("data-active", art.getAttribute("data-stage") === key ? "true" : "false");
      });

      closeStage();
      if (nameEl) nameEl.textContent = btn.dataset.name ?? "";
      if (categoryEl) categoryEl.textContent = btn.dataset.category ?? "";
    });
  });

  openToggle?.addEventListener("click", () => {
    const isOpen = openToggle.getAttribute("aria-pressed") === "true";
    openToggle.setAttribute("aria-pressed", String(!isOpen));
    if (openLabel) openLabel.textContent = isOpen ? "View Open" : "View Closed";
    stageArts.forEach((art) => {
      if (art.getAttribute("data-active") === "true") art.setAttribute("data-open", String(!isOpen));
    });
  });

  swatches.forEach((btn) => {
    btn.addEventListener("click", () => {
      swatches.forEach((b) => b.setAttribute("aria-checked", "false"));
      btn.setAttribute("aria-checked", "true");

      const color = btn.dataset.swatch ?? "";
      host?.style.setProperty("--uf-cfg-color", color);

      if (finishEl) finishEl.textContent = btn.dataset.name ?? "";
      if (descriptionEl) descriptionEl.textContent = btn.dataset.description ?? "";
    });
  });
</script>
