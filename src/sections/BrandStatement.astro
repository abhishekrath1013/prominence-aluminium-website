---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import Frame from "../components/Frame.astro";
import { images } from "../assets/images";
---

<section class="relative overflow-hidden bg-off-white" data-reveal-group>
  <div class="grid grid-cols-1 lg:grid-cols-12">
    <div class="relative order-2 flex flex-col justify-center px-6 py-20 sm:px-10 lg:order-1 lg:col-span-7 lg:px-16 lg:py-0 xl:col-span-6">
      <div class="relative">
        <Eyebrow index="02" class="text-ink/65" data-reveal="fade">Brand Philosophy</Eyebrow>

        <p
          class="mt-10 max-w-xl font-display text-[clamp(2.5rem,5.2vw,4.25rem)] leading-[1.08] text-ink text-balance"
          data-reveal="up"
        >
          Where the frame disappears, <span class="italic text-brass">the view begins.</span>
        </p>

        <p class="mt-8 max-w-sm text-sm leading-relaxed text-ink/60" data-reveal="up">
          Every Prominance system is engineered to hold structure at its slimmest possible line — so light,
          landscape and architecture take precedence over the window itself. It is a discipline we apply to
          every joint, every reveal, every finish.
        </p>

        <div class="mt-10 rule-thin w-16" data-line-draw></div>
      </div>
    </div>

    <div class="uf-frame-host group relative order-1 h-[40vh] w-full lg:order-2 lg:col-span-5 lg:h-auto xl:col-span-6" data-reveal="fade">
      <Image
        src={images.detailConcreteWoodDoor}
        alt="A moody detail shot of an aluminium door frame set into a concrete and timber elevation."
        class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.02]"
        loading="lazy"
        widths={[500, 900, 1300]}
        sizes="(min-width: 1024px) 45vw, 100vw"
      />
      <Frame tone="off-white" hover />
    </div>
  </div>
</section>
