---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import { images } from "../assets/images";
import { engineeringStats } from "../data/company";
---

<section class="relative overflow-hidden bg-ink text-off-white" data-reveal-group>
  <span class="uf-numeral left-0 text-off-white" aria-hidden="true">04</span>

  <div class="relative h-[56vh] min-h-[380px] w-full overflow-hidden md:h-[64vh]" data-reveal="fade">
    <Image
      src={images.materialExtrusionMacro}
      alt="Macro detail of raw 6063 T-6 aluminium extrusions, stacked before fabrication."
      class="h-full w-full object-cover"
      loading="lazy"
      widths={[800, 1400, 2000]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-transparent to-transparent"></div>

    <div class="container-frame relative flex h-full flex-col justify-end pb-12 md:pb-16">
      <div class="relative max-w-2xl">
        <Eyebrow index="04" class="text-aluminium" data-reveal="fade">Material</Eyebrow>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.05] text-balance" data-reveal="up">
          Engineered in virgin aluminium.
        </h2>
        <p class="mt-6 max-w-lg text-sm leading-relaxed text-stone md:text-base" data-reveal="up">
          Every profile begins as 6063 T-6 virgin aluminium — naturally corrosion-resistant, fully recyclable,
          and precise enough to hold a hairline reveal at every joint.
        </p>
      </div>
    </div>
  </div>

  <div class="container-frame relative py-16 md:py-20">
    <p class="max-w-sm text-sm leading-relaxed text-stone" data-reveal="up">
      Presented the way an engineering catalogue would — every figure below is a verified Prominance
      specification, not a marketing estimate.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-5">
      {
        engineeringStats.map((stat) => {
          const match = stat.value.match(/^([\d,]+)(.*)$/);
          const isNumeric = Boolean(match);
          const numeric = match ? match[1].replace(/,/g, "") : "";
          const suffix = match ? match[2] : "";
          return (
            <div data-reveal="up" class="border-t border-off-white/15 pt-6">
              <p class="font-display text-[clamp(2.25rem,3.4vw,3rem)] leading-none text-off-white">
                {isNumeric ? (
                  <>
                    <span data-counter={numeric}>0</span>
                    {suffix}
                  </>
                ) : (
                  <span>{stat.value}</span>
                )}
                {stat.unit && <span class="ml-1 text-lg text-aluminium">{stat.unit}</span>}
              </p>
              <p class="mt-4 text-sm text-stone">{stat.label}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

