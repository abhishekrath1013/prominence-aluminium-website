---
// A cinematic hero: a real looped video (licensed free/commercial-use stock
// footage of a modern villa with aluminium sliding glazing — videos/media
// provenance noted in public/media/hero-villa-credit.txt), muted/looping,
// with a poster frame for instant paint before the clip loads.
---

<section class="uf-hero relative h-[92svh] min-h-[560px] w-full overflow-hidden bg-ink">
  <div class="uf-hero-stage absolute inset-0" aria-hidden="true">
    <video
      class="h-full w-full object-cover"
      poster="/media/hero-villa-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      data-hero-video
    >
      <source src="/media/hero-villa.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/15 to-ink/65"></div>
    <div class="uf-hero-text-scrim absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="container-frame relative z-10 flex h-full flex-col justify-end pb-20 pt-32 md:pb-24">
    <p class="uf-hero-in label-eyebrow text-off-white/70" style="animation-delay: 0.05s">Precision-Engineered Aluminium Systems</p>
    <h1 class="uf-hero-in mt-5 max-w-2xl font-display text-[clamp(2.25rem,5vw,4.25rem)] leading-[1.05] text-off-white text-balance" style="animation-delay: 0.15s">
      Where the frame disappears, <span class="italic text-brass-soft">the view begins.</span>
    </h1>
    <p class="uf-hero-in mt-6 max-w-md text-base leading-relaxed text-off-white/70" style="animation-delay: 0.28s">
      Prominance crafts aluminium window, door and facade systems for architects who specify to the millimetre.
    </p>

    <div class="uf-hero-in mt-9 flex flex-wrap items-center gap-4" style="animation-delay: 0.4s">
      <a
        href="/contact-us/"
        class="inline-flex items-center gap-2 rounded-full bg-brass px-7 py-4 text-sm font-semibold text-ink transition-precise hover:bg-off-white"
      >
        Get a Quote
      </a>
      <a
        href="/products/"
        class="uf-frame-host inline-flex items-center gap-3 rounded-full border border-off-white/40 px-7 py-4 text-off-white transition-precise hover:border-off-white"
      >
        <span class="label-eyebrow">Explore Products</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* The hero is always in view on load, so its entrance animates in plain
     CSS, not the scroll-triggered [data-reveal] system (which depends on
     GSAP/ScrollTrigger finishing init and can race or silently fail for
     content that's already on-screen at first paint — exactly the content
     that must never be stuck invisible). */
  .uf-hero-in {
    opacity: 0;
    animation: uf-hero-in 0.9s var(--ease-precise) forwards;
  }

  @keyframes uf-hero-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* A second, dedicated scrim focused on the text block itself — dark right
     behind the headline/copy, fading to transparent away from it — so the
     text stays readable no matter how bright that patch of video happens to
     be, independent of the full-frame top/bottom gradient above. */
  .uf-hero-text-scrim {
    background: radial-gradient(ellipse 900px 650px at 18% 82%, rgb(11 26 38 / 0.85), transparent 68%);
  }

  @media (max-width: 48rem) {
    .uf-hero-text-scrim {
      background: radial-gradient(ellipse 100% 70% at 50% 100%, rgb(11 26 38 / 0.85), transparent 70%);
    }
  }
</style>

<script>
  // Respect reduced motion: pause on the poster frame rather than autoplaying.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.removeAttribute("autoplay");
    video.pause();
  }
</script>
