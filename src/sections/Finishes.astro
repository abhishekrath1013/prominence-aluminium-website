---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import Frame from "../components/Frame.astro";
import { finishes } from "../data/finishes";
import { images } from "../assets/images";
const first = finishes[0];
---

<section class="bg-off-white py-24 md:py-36" data-reveal-group>
  <div class="container-frame">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow index="07" class="text-ink/65" data-reveal="fade">Finishes</Eyebrow>
        <h2 class="mt-6 max-w-xl font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] text-ink text-balance" data-reveal="up">
          Over 100 colours and textures.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal="up">
        A representative selection from our finish range — anodised, powder-coated and metallic, chosen
        against Prominance's 100+ available colours.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12" data-reveal="up">
      <div class="uf-frame-host relative md:col-span-7">
        <div class="relative aspect-[4/3] w-full overflow-hidden md:aspect-[16/10]">
          <Image
            src={images.lifestyleCasementGardenWarm}
            alt="Preview of an aluminium frame in the selected finish."
            class="h-full w-full object-cover"
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 55vw, 100vw"
          />
          <div id="uf-finish-tint" class="uf-finish-tint absolute inset-0" style={`background-color:${first.swatch}`}></div>
          <Frame hover />
        </div>
      </div>

      <div class="flex flex-col justify-center md:col-span-5">
        <p id="uf-finish-name" class="font-display text-3xl text-ink">{first.name}</p>
        <p id="uf-finish-description" class="mt-4 max-w-sm text-sm leading-relaxed text-ink/60">{first.description}</p>

        <div class="mt-10 flex flex-wrap gap-4" role="radiogroup" aria-label="Select a finish">
          {
            finishes.map((f, i) => (
              <button
                type="button"
                class="uf-finish-swatch group relative h-11 w-11 rounded-full border border-ink/15 transition-precise"
                style={`background-color:${f.swatch}`}
                data-name={f.name}
                data-description={f.description}
                data-swatch={f.swatch}
                role="radio"
                aria-checked={i === 0 ? "true" : "false"}
                aria-label={f.name}
              >
                <span class="uf-finish-ring absolute -inset-1.5 rounded-full border border-ink transition-precise" />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .uf-finish-tint {
    mix-blend-mode: color;
    opacity: 0.85;
    transition: background-color var(--duration-normal) var(--ease-precise);
  }

  .uf-finish-ring {
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity var(--duration-micro) var(--ease-precise),
      transform var(--duration-micro) var(--ease-precise);
  }

  .uf-finish-swatch[aria-checked="true"] .uf-finish-ring,
  .uf-finish-swatch:hover .uf-finish-ring {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  const swatches = document.querySelectorAll<HTMLButtonElement>(".uf-finish-swatch");
  const tint = document.getElementById("uf-finish-tint");
  const nameEl = document.getElementById("uf-finish-name");
  const descEl = document.getElementById("uf-finish-description");

  swatches.forEach((btn) => {
    btn.addEventListener("click", () => {
      swatches.forEach((b) => b.setAttribute("aria-checked", "false"));
      btn.setAttribute("aria-checked", "true");

      if (tint) tint.style.backgroundColor = btn.dataset.swatch ?? "";
      if (nameEl) nameEl.textContent = btn.dataset.name ?? "";
      if (descEl) descEl.textContent = btn.dataset.description ?? "";
    });
  });
</script>
