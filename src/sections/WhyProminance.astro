---
import Eyebrow from "../components/Eyebrow.astro";
import { engineeringStats } from "../data/company";
---

<section class="bg-ink py-24 text-off-white md:py-32" data-reveal-group>
  <div class="container-frame">
    <Eyebrow class="text-aluminium" data-reveal="fade">Why Prominance</Eyebrow>
    <h2 class="mt-6 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-balance" data-reveal="up">
      Engineering you can verify, not just trust.
    </h2>
  </div>

  <div class="uf-why-grid container-frame mt-14 grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-5" data-reveal="up">
    {
      engineeringStats.map((stat) => {
        // Only count up clean magnitudes (digits + optional %/+) — leaves an
        // alloy code like "6063 T-6" displayed as static text, not animated.
        const match = stat.value.match(/^([\d,]+)(%|\+)?$/);
        const numeric = match ? match[1].replace(/,/g, "") : null;
        const suffix = match ? (match[2] ?? "") : "";
        return (
          <div class="uf-why-stat">
            <p
              class="font-display text-[clamp(2rem,4vw,2.75rem)] leading-none text-off-white"
              data-count={numeric && !isNaN(Number(numeric)) ? Number(numeric) : undefined}
              data-suffix={suffix}
            >
              {stat.value}
            </p>
            {stat.unit && <p class="mt-1 label-eyebrow text-brass-soft">{stat.unit}</p>}
            <p class="mt-3 max-w-[14rem] text-sm leading-relaxed text-stone">{stat.label}</p>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const els = document.querySelectorAll<HTMLElement>(".uf-why-grid [data-count]");
  if (els.length && !reduceMotion) {
    const formatIndian = (n: number) => {
      // Mirrors the "1,00,000"-style grouping used in the source data.
      const s = Math.round(n).toString();
      if (s.length <= 3) return s;
      const last3 = s.slice(-3);
      const rest = s.slice(0, -3);
      return rest.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + "," + last3;
    };

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? "";
          const counter = { value: 0 };
          gsap.to(counter, {
            value: target,
            duration: 1.6,
            ease: "power2.out",
            onUpdate: () => {
              el.textContent = `${formatIndian(counter.value)}${suffix}`;
            },
          });
          obs.unobserve(el);
        });
      },
      { threshold: 0.4 },
    );
    els.forEach((el) => observer.observe(el));
  }
</script>
