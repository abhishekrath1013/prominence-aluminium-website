---
import Eyebrow from "../components/Eyebrow.astro";
import ContactForm from "../components/ContactForm.astro";
import { company } from "../data/company";
---

<section class="bg-off-white py-24 md:py-36" data-reveal-group>
  <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12 md:gap-12">
    <div class="md:col-span-6">
      <Eyebrow index="10" class="text-ink/65" data-reveal="fade">Contact</Eyebrow>
      <h2 class="mt-6 font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.98] text-ink text-balance" data-reveal="up">
        Let’s frame <span class="italic text-ink/45">your next space.</span>
      </h2>
      <p class="mt-8 max-w-sm text-sm leading-relaxed text-ink/60" data-reveal="up">
        Speak with our team about a residential project, an architectural specification, or a fabrication
        partnership.
      </p>

      <div class="mt-10 flex flex-col gap-3 label-eyebrow text-ink/70" data-reveal="up">
        <a href={company.phoneHref} class="hover:text-ink transition-precise">{company.phoneDisplay}</a>
        <a href={`mailto:${company.email}`} class="hover:text-ink transition-precise">{company.email}</a>
      </div>
    </div>

    <div class="md:col-span-6" data-reveal="up">
      <ContactForm tone="light" />
    </div>
  </div>
</section>
