---
import Eyebrow from "../components/Eyebrow.astro";
import { products } from "../data/products";

function findSpec(rows: { label: string; value: string }[], prefix: string) {
  const row = rows.find((r) => r.label.toLowerCase().startsWith(prefix.toLowerCase()));
  return row?.value ?? "—";
}

const testCategories = [
  "Corrosion Resistance",
  "Air Tightness",
  "Water Tightness",
  "Structural Rigidity",
  "Acoustic Performance",
  "Hardware Endurance — up to 1,00,000 cycles",
] as const;
---

<section class="relative overflow-hidden bg-ink py-24 text-off-white md:py-36" data-reveal-group>
  <div class="container-frame relative">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow index="08" class="text-aluminium" data-reveal="fade">Proof</Eyebrow>
        <h2 class="mt-6 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-balance" data-reveal="up">
          Performance, published in full.
        </h2>
        <p class="mt-5 label-eyebrow text-stone">"Built like a vault" — every system, tested to failure before it ships.</p>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-stone" data-reveal="up">
        Wind load, air permeability and water tightness are design ratings verified for every Prominance system.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3" data-reveal="up">
      {
        testCategories.map((label) => (
          <span class="rounded-full border border-off-white/15 px-4 py-2 text-xs text-stone">{label}</span>
        ))
      }
    </div>

    <div class="mt-16 overflow-x-auto" data-reveal="up">
      <table class="uf-proof-table w-full min-w-[720px] border-collapse text-left">
        <thead>
          <tr class="label-eyebrow text-aluminium">
            <th class="border-b border-off-white/15 pb-4 pr-6 font-normal">System</th>
            <th class="border-b border-off-white/15 pb-4 pr-6 font-normal">Wind Load</th>
            <th class="border-b border-off-white/15 pb-4 pr-6 font-normal">Air Permeability</th>
            <th class="border-b border-off-white/15 pb-4 pr-6 font-normal">Water Tightness</th>
            <th class="border-b border-off-white/15 pb-4 font-normal">Hardware</th>
          </tr>
        </thead>
        <tbody>
          {
            products.map((p) => (
              <tr class="group">
                <td class="border-b border-off-white/10 py-5 pr-6">
                  <a href={`/${p.slug}/`} class="font-display text-lg transition-precise group-hover:opacity-60">
                    {p.name}
                  </a>
                </td>
                <td class="border-b border-off-white/10 py-5 pr-6 text-sm text-stone">
                  {findSpec(p.performance, "Wind load")}
                </td>
                <td class="border-b border-off-white/10 py-5 pr-6 text-sm text-stone">
                  {findSpec(p.performance, "Air permeability")}
                </td>
                <td class="border-b border-off-white/10 py-5 pr-6 text-sm text-stone">
                  {findSpec(p.performance, "Water tightness")}
                </td>
                <td class="border-b border-off-white/10 py-5 text-sm text-stone">{p.hardware.split(",")[0].split(".")[0]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
