---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import Frame from "../components/Frame.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { projects } from "../data/projects";

const featured = projects.slice(0, 4);
---

<section class="bg-off-white py-16 md:py-24" data-reveal-group>
  <div class="container-frame">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow index="07" class="text-ink/65" data-reveal="fade">Applications</Eyebrow>
        <h2 class="mt-6 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-ink text-balance" data-reveal="up">
          Prominance systems, in architectural context.
        </h2>
      </div>
      <div data-reveal="up">
        <ArrowLink href="/projects/">View All Applications</ArrowLink>
      </div>
    </div>
  </div>

  <div class="container-frame mt-16 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-5">
    {
      featured.map((project) => (
        <a
          href={`/projects/${project.slug}/`}
          class="uf-frame-host group relative block overflow-hidden"
          data-reveal="up"
          data-cursor-hover
        >
          <div class="relative aspect-[3/4] w-full overflow-hidden">
            <Image
              src={project.image}
              alt={`${project.title} — featuring the ${project.systemName} system.`}
              class="h-full w-full object-cover transition-precise duration-[1200ms] group-hover:scale-[1.08]"
              loading="lazy"
              widths={[400, 800, 1200]}
              sizes="(min-width: 640px) 50vw, 100vw"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
            <Frame tone="off-white" hover />

            <div class="absolute inset-x-3 bottom-3 flex items-end justify-between gap-2">
              <div class="min-w-0">
                <p class="label-eyebrow text-off-white/70">{project.systemName}</p>
                <p class="mt-1.5 truncate font-display text-base text-off-white">{project.title}</p>
              </div>
              <svg width="16" height="10" viewBox="0 0 18 10" fill="none" class="flex-none text-off-white opacity-0 transition-precise group-hover:opacity-100">
                <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
              </svg>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
