---
import { Image } from "astro:assets";
import Eyebrow from "../components/Eyebrow.astro";
import ArrowLink from "../components/ArrowLink.astro";
import Frame from "../components/Frame.astro";
import { getProduct } from "../data/products";

const featuredSlugs = ["graf-45", "livio", "graf-73", "robus-40"];
const featured = featuredSlugs.map((s) => getProduct(s)!).filter(Boolean);
---

<section id="collection" class="uf-showcase relative overflow-hidden bg-ink py-16 md:py-24" data-reveal-group>
  <div class="uf-showcase-glow" aria-hidden="true"></div>

  <div class="container-frame relative">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow index="05" class="text-aluminium" data-reveal="fade">The Collection</Eyebrow>
        <h2 class="mt-6 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-off-white text-balance" data-reveal="up">
          Sliding and casement systems, presented as one family.
        </h2>
      </div>
      <div data-reveal="up">
        <ArrowLink href="/products/" variant="light">View All Products</ArrowLink>
      </div>
    </div>
  </div>

  <div class="relative mt-16 flex flex-col md:mt-24">
    {
      featured.map((product, i) => (
        <a
          href={`/${product.slug}/`}
          class="uf-frame-host group relative grid grid-cols-1 items-stretch lg:grid-cols-2"
          data-reveal="up"
          data-cursor-hover
        >
          <div class={`relative h-[42vh] w-full overflow-hidden lg:h-[54vh] ${i % 2 === 1 ? "lg:order-2" : ""}`}>
            <Image
              src={product.cardImage}
              alt={`${product.fullTitle} — ${product.headline}`}
              class="h-full w-full object-cover transition-precise duration-[1400ms] group-hover:scale-[1.04]"
              loading="lazy"
              widths={[600, 1100, 1700]}
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/30 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-transparent lg:to-ink/10" />
            <Frame tone="off-white" hover />
          </div>

          <div class={`relative flex flex-col justify-center overflow-hidden bg-ink px-6 py-14 sm:px-10 lg:px-16 xl:px-20 ${i % 2 === 1 ? "lg:order-1" : ""}`}>
            <div class="relative">
              <p class="label-eyebrow text-aluminium">{product.category}</p>
              <h3 class="uf-product-title mt-5 font-display text-[clamp(2.5rem,5vw,4.25rem)] leading-none text-off-white transition-precise">
                {product.name}
              </h3>
              <p class="mt-6 max-w-sm text-sm leading-relaxed text-stone md:text-base">{product.headline}</p>
              <div class="mt-9 inline-flex items-center gap-3 text-off-white">
                <span class="label-eyebrow">Explore Product</span>
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="transition-precise group-hover:translate-x-1">
                  <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .uf-showcase-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 15% 8%, rgb(176 141 87 / 0.08), transparent 70%),
      radial-gradient(50% 40% at 85% 92%, rgb(176 141 87 / 0.06), transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .group:hover .uf-product-title {
    transform: translateX(6px);
  }
</style>
