---
import { company } from "../data/company";
---

<section class="border-t border-off-white/10 bg-ink py-16 text-off-white">
  <div class="container-frame flex flex-col gap-8 md:flex-row md:items-center md:justify-between md:gap-16">
    <div class="max-w-md">
      <p class="label-eyebrow text-aluminium">Stay Specified</p>
      <h2 class="mt-3 font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-balance">
        Notes on material, finish and performance — occasionally, not often.
      </h2>
    </div>

    <div class="w-full md:max-w-md">
      <form class="uf-newsletter-form flex w-full flex-col gap-4 sm:flex-row" id="uf-newsletter-form" data-endpoint-email={company.email}>
        <label class="sr-only" for="uf-newsletter-email">Email address</label>
        <input
          id="uf-newsletter-email"
          type="email"
          name="email"
          required
          placeholder="you@studio.com"
          autocomplete="email"
          class="flex-1 border-b border-off-white/30 bg-transparent px-1 py-3 text-sm text-off-white placeholder:text-off-white/40 focus:border-off-white focus:outline-none"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-white transition-precise hover:bg-off-white hover:text-ink"
        >
          Subscribe
        </button>
      </form>
      <p class="uf-newsletter-status mt-3 text-xs text-aluminium" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("uf-newsletter-form") as HTMLFormElement | null;
  const status = form?.parentElement?.querySelector<HTMLParagraphElement>(".uf-newsletter-status");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = form.dataset.endpointEmail ?? "enquiry@uniframe.com";
    const subject = encodeURIComponent("Newsletter subscription request");
    const body = encodeURIComponent(`Please add this address to the Prominance newsletter: ${data.get("email")}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    if (status) status.textContent = "Opening your email client to confirm…";
  });
</script>
