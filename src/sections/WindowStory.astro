---
import Eyebrow from "../components/Eyebrow.astro";

// A line-art slider: raw aluminium billet through to an installed, glowing
// window in a customer's home — five manual steps, no scroll-jacking. Each
// scene lives on one shared strip (unchanged line art), and advancing a step
// pans + crossfades to the next scene's centred position on click/swipe.
// xUnit matches the scene marker dots on the spine (350/1000/1650/2300/2900 of
// the 3200-wide viewBox) — the caption track shares the svg's exact rendered
// width, so a caption anchored at (xUnit / 3200 * 100)% always sits directly
// under its scene.
const steps = [
  { label: "Extruded", copy: "Every profile begins as 6063 T-6 virgin aluminium billet, pressed through a die to the millimetre.", xUnit: 350 },
  { label: "Cut & Joined", copy: "Profiles are mitred and locked at a true 90° with reinforced corner cleats.", xUnit: 1000 },
  { label: "Glazed", copy: "Glass sets into a continuous gasket line — a hairline reveal, sealed for life.", xUnit: 1650 },
  { label: "Delivered", copy: "Every unit is crated and inspected before it leaves the factory floor.", xUnit: 2300 },
  { label: "Installed", copy: "Fitted on site — the frame disappears, and the view begins.", xUnit: 2900 },
] as const;
const svgViewBoxWidth = 3200;
---

<section class="uf-story relative bg-ink py-20 md:py-28" data-story-section aria-label="How a Prominance window is made, from raw aluminium to an installed window">
  <div class="uf-story-heading container-frame" data-reveal-group>
    <Eyebrow index="—" class="text-aluminium justify-center" data-reveal="fade">The Making Of</Eyebrow>
    <h2 class="mx-auto mt-4 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.1] text-off-white text-balance" data-reveal="up">
      From billet to elevation.
    </h2>
  </div>

  <div class="uf-story-viewport mt-10">
    <svg class="uf-story-svg" viewBox="0 0 3200 640" preserveAspectRatio="xMinYMid meet" role="img" aria-hidden="true">
      <defs>
        <linearGradient id="j-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#eef3f6" stop-opacity="0.75" />
          <stop offset="55%" stop-color="#9fb0b9" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#eef3f6" stop-opacity="0.7" />
        </linearGradient>
        <radialGradient id="j-glow" cx="50%" cy="55%" r="65%">
          <stop offset="0%" stop-color="#fbe2a6" stop-opacity="0.95" />
          <stop offset="35%" stop-color="#f3d9a6" stop-opacity="0.65" />
          <stop offset="100%" stop-color="#f3d9a6" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="j-metal" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f7f5f0" stop-opacity="0.12" />
          <stop offset="46%" stop-color="#f7f5f0" stop-opacity="0.5" />
          <stop offset="53%" stop-color="#f7f5f0" stop-opacity="0.85" />
          <stop offset="60%" stop-color="#f7f5f0" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#f7f5f0" stop-opacity="0.12" />
        </linearGradient>
        <radialGradient id="j-heat" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#6bb3e0" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#6bb3e0" stop-opacity="0" />
        </radialGradient>
        <pattern id="j-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="9" stroke="#f7f5f0" stroke-width="1" opacity="0.3" />
        </pattern>
      </defs>

      <!-- spine: always visible, ties every scene to one ground line -->
      <line x1="0" y1="560" x2="3200" y2="560" stroke="#f7f5f0" stroke-width="1.5" opacity="0.14" />
      {[350, 1000, 1650, 2300, 2900].map((cx) => (
        <g>
          <circle cx={cx} cy="560" r="7" fill="none" stroke="#6bb3e0" stroke-width="1" opacity="0.22" />
          <circle cx={cx} cy="560" r="3" fill="#f7f5f0" opacity="0.32" data-spine-dot />
        </g>
      ))}

      <!-- ================= SCENE 1 — EXTRUDED ================= -->
      <g id="j-scene-1" class="uf-story-scene" opacity="0" stroke="#f7f5f0" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <!-- billet stock -->
        <rect x="120" y="444" width="120" height="62" rx="31" />
        <rect x="124" y="448" width="112" height="54" rx="27" fill="url(#j-hatch)" stroke="none" opacity="0.6" />
        <line x1="156" y1="444" x2="156" y2="506" opacity="0.3" stroke-width="1.25" />
        <line x1="204" y1="444" x2="204" y2="506" opacity="0.3" stroke-width="1.25" />
        <path d="M140,506 L132,558 M224,506 L232,558" stroke-width="2" opacity="0.5" />

        <!-- press housing -->
        <circle cx="440" cy="475" r="72" fill="url(#j-heat)" stroke="none" />
        <rect x="280" y="350" width="160" height="200" rx="8" stroke-width="3" />
        <line x1="280" y1="392" x2="440" y2="392" opacity="0.3" stroke-width="1.25" />
        <line x1="280" y1="525" x2="440" y2="525" opacity="0.3" stroke-width="1.25" />

        <!-- ram -->
        <rect x="240" y="452" width="40" height="46" opacity="0.85" fill="url(#j-hatch)" />
        <path d="M248,470 L258,475 L248,480 M260,470 L270,475 L260,480" stroke-width="1.5" opacity="0.65" />

        <!-- die plate + profile bore -->
        <rect x="412" y="350" width="28" height="200" stroke-width="3" />
        <path d="M420,440 H434 V458 H428 V492 H434 V510 H420 Z" fill="var(--color-ink)" stroke="#f7f5f0" stroke-width="1.5" />

        <!-- extruded bar -->
        <g id="j-bar">
          <rect x="440" y="452" width="232" height="46" rx="3" fill="var(--color-ink)" stroke="#f7f5f0" stroke-width="2.5" />
          <rect x="440" y="452" width="232" height="46" rx="3" fill="url(#j-metal)" stroke="none" opacity="0.65" />
          {[480, 520, 560, 600, 640].map((x) => (
            <line x1={x} y1="458" x2={x} y2="492" stroke-width="1.1" opacity="0.22" />
          ))}
          <path d="M440,513 L440,520 M672,513 L672,520 M440,516.5 L672,516.5" stroke="#85c48c" stroke-width="1.1" opacity="0.5" />
        </g>
      </g>

      <!-- ================= SCENE 2 — CUT & JOINED ================= -->
      <g id="j-scene-2" class="uf-story-scene" opacity="0" stroke="#f7f5f0" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <!-- profile bar on the jig -->
        <rect x="800" y="498" width="380" height="26" rx="2" />
        <line x1="806" y1="505" x2="1174" y2="505" opacity="0.28" stroke-width="1.1" />
        <line x1="806" y1="517" x2="1174" y2="517" opacity="0.28" stroke-width="1.1" />
        <path d="M846,524 L832,558 M866,524 L880,558 M1114,524 L1100,558 M1134,524 L1148,558" stroke-width="2" opacity="0.5" />

        <!-- cut gap -->
        <rect id="j-cut-gap" x="988" y="493" width="34" height="36" fill="var(--color-ink)" stroke="none" />

        <!-- saw -->
        <g id="j-saw">
          <line x1="1005" y1="372" x2="1005" y2="452" stroke-width="3" />
          <rect x="968" y="328" width="74" height="46" rx="12" stroke-width="2.5" />
          <path d="M988,328 Q1005,308 1022,328" stroke-width="2.5" />
          <path d="M972,462 A34,34 0 0 1 1038,462" stroke-width="2.75" />
          <g transform="rotate(22 1005 491)">
            <circle cx="1005" cy="491" r="33" stroke-width="2.5" />
            <circle cx="1005" cy="491" r="6" stroke-width="1.5" />
            {Array.from({ length: 16 }, (_, i) => i * 22.5).map((a) => (
              <line
                x1={1005 + Math.cos((a * Math.PI) / 180) * 28}
                y1={491 + Math.sin((a * Math.PI) / 180) * 28}
                x2={1005 + Math.cos((a * Math.PI) / 180) * 40}
                y2={491 + Math.sin((a * Math.PI) / 180) * 40}
                stroke-width="1.4"
              />
            ))}
          </g>
          <path d="M1042,468 L1055,460 M1046,479 L1060,472" stroke="#6bb3e0" stroke-width="1.5" opacity="0.6" />
        </g>

        <!-- joined corner detail -->
        <rect x="955" y="248" width="28" height="172" rx="2" stroke-width="2.5" />
        <rect x="955" y="392" width="160" height="28" rx="2" stroke-width="2.5" />
        <path d="M955,420 L983,392" stroke-width="1.5" stroke-dasharray="3 4" opacity="0.6" />
        <path d="M1000,420 L1005,452" stroke-width="1" stroke-dasharray="2 4" opacity="0.3" />
        <g id="j-cleat">
          <rect x="945" y="378" width="34" height="34" transform="rotate(45 962 395)" fill="#3f9a46" opacity="0.22" stroke="#85c48c" stroke-width="1.5" />
          <circle cx="954" cy="386" r="2.2" fill="#85c48c" stroke="none" />
          <circle cx="970" cy="402" r="2.2" fill="#85c48c" stroke="none" />
        </g>
      </g>

      <!-- ================= SCENE 3 — GLAZED ================= -->
      <g id="j-scene-3" class="uf-story-scene" opacity="0" stroke="#f7f5f0" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1500" y="322" width="300" height="236" stroke-width="1.25" stroke-dasharray="4 6" opacity="0.28" />

        <path
          fill="#f7f5f0"
          fill-rule="evenodd"
          stroke="none"
          d="M1520,340 H1780 V540 H1520 Z M1532,352 H1768 V528 H1532 Z M1644,352 H1656 V528 H1644 Z"
        />
        <rect x="1536" y="356" width="104" height="168" stroke-width="1" opacity="0.3" />
        <rect x="1660" y="356" width="104" height="168" stroke-width="1" opacity="0.3" />

        <g id="j-panes">
          <rect x="1532" y="352" width="112" height="176" fill="url(#j-glass)" />
          <rect x="1656" y="352" width="112" height="176" fill="url(#j-glass)" />
          <path d="M1540,520 L1560,352 L1572,352 L1552,520 Z" fill="#f7f5f0" opacity="0.08" stroke="none" />
          <path d="M1664,520 L1684,352 L1696,352 L1676,520 Z" fill="#f7f5f0" opacity="0.08" stroke="none" />
        </g>

        <rect x="1534" y="354" width="108" height="172" rx="2" stroke="#6bb3e0" stroke-width="1.5" stroke-dasharray="1 5" opacity="0.6" />
        <rect x="1658" y="354" width="108" height="172" rx="2" stroke="#6bb3e0" stroke-width="1.5" stroke-dasharray="1 5" opacity="0.6" />

        <rect x="1572" y="524" width="16" height="8" opacity="0.5" />
        <rect x="1696" y="524" width="16" height="8" opacity="0.5" />

        <g id="j-glaze-tool" stroke="#f7f5f0" stroke-width="2" fill="none">
          <line x1="1600" y1="478" x2="1648" y2="478" />
          <path d="M1600,478 Q1596,460 1614,458" />
          <circle cx="1612" cy="494" r="11" />
          <circle cx="1612" cy="494" r="5" opacity="0.6" stroke-width="1.3" />
          <circle cx="1600" cy="510" r="11" />
          <circle cx="1600" cy="510" r="5" opacity="0.6" stroke-width="1.3" />
        </g>
      </g>

      <!-- ================= SCENE 4 — DELIVERED ================= -->
      <g id="j-scene-4" class="uf-story-scene" opacity="0" stroke="#f7f5f0" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2096,540 H2366" stroke-dasharray="10 12" opacity="0.3" stroke-width="1.5" />

        <!-- cab -->
        <path d="M2130,540 L2130,488 L2148,488 L2166,458 L2192,458 L2192,540 Z" stroke-width="2.5" />
        <path d="M2146,484 L2160,462 L2188,462 L2188,484 Z" fill="url(#j-glass)" stroke-width="1.5" opacity="0.6" />
        <line x1="2130" y1="512" x2="2142" y2="512" opacity="0.4" stroke-width="1.1" />
        <line x1="2130" y1="524" x2="2142" y2="524" opacity="0.4" stroke-width="1.1" />
        <circle cx="2136" cy="531" r="4" opacity="0.5" />
        <rect x="2196" y="460" width="10" height="16" stroke-width="1.3" opacity="0.6" />
        <line x1="2192" y1="468" x2="2196" y2="468" stroke-width="1.3" opacity="0.6" />
        <line x1="2192" y1="458" x2="2192" y2="440" stroke-width="1.5" opacity="0.5" />
        <rect x="2188" y="436" width="8" height="6" stroke-width="1.3" opacity="0.5" />

        <!-- cargo box -->
        <rect x="2192" y="428" width="170" height="112" stroke-width="2.5" />
        <line x1="2230" y1="428" x2="2230" y2="540" opacity="0.4" stroke-width="1.25" />
        <line x1="2324" y1="428" x2="2324" y2="540" opacity="0.4" stroke-width="1.25" />
        <line x1="2192" y1="478" x2="2362" y2="478" opacity="0.4" stroke-width="1.25" />
        <path d="M2196,432 L2206,432 L2206,440 M2358,432 L2348,432 L2348,440 M2196,536 L2206,536 L2206,528 M2358,536 L2348,536 L2348,528" stroke-width="1.25" opacity="0.5" />

        <!-- cargo window preview -->
        <g id="j-cargo-window">
          <rect x="2245" y="450" width="70" height="60" fill="url(#j-glass)" opacity="0.7" />
          <rect x="2245" y="450" width="70" height="60" />
          <line x1="2280" y1="450" x2="2280" y2="510" />
          <line x1="2245" y1="480" x2="2315" y2="480" />
        </g>

        <!-- wheels -->
        <circle cx="2160" cy="545" r="20" fill="var(--color-ink)" />
        <circle cx="2160" cy="545" r="20" />
        <circle cx="2160" cy="545" r="7" stroke-width="1.5" />
        {[0, 72, 144, 216, 288].map((a) => (
          <line
            x1={2160 + Math.cos((a * Math.PI) / 180) * 7}
            y1={545 + Math.sin((a * Math.PI) / 180) * 7}
            x2={2160 + Math.cos((a * Math.PI) / 180) * 18}
            y2={545 + Math.sin((a * Math.PI) / 180) * 18}
            stroke-width="1"
            opacity="0.5"
          />
        ))}
        <circle cx="2318" cy="545" r="20" fill="var(--color-ink)" />
        <circle cx="2318" cy="545" r="20" />
        <circle cx="2318" cy="545" r="7" stroke-width="1.5" />
        {[0, 72, 144, 216, 288].map((a) => (
          <line
            x1={2318 + Math.cos((a * Math.PI) / 180) * 7}
            y1={545 + Math.sin((a * Math.PI) / 180) * 7}
            x2={2318 + Math.cos((a * Math.PI) / 180) * 18}
            y2={545 + Math.sin((a * Math.PI) / 180) * 18}
            stroke-width="1"
            opacity="0.5"
          />
        ))}
      </g>

      <!-- ================= SCENE 5 — INSTALLED ================= -->
      <g id="j-scene-5" class="uf-story-scene" opacity="0" stroke="#f7f5f0" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <!-- roof -->
        <path d="M2690,340 L2900,205 L3110,340 Z" stroke-linejoin="round" stroke-width="3" />
        <line x1="2900" y1="205" x2="2900" y2="222" stroke-width="2" opacity="0.6" />
        {[
          [2730, 321, 2745, 312], [2770, 297, 2785, 288], [2810, 273, 2825, 264], [2850, 249, 2865, 240],
          [2940, 228, 2953, 236], [2980, 252, 2993, 260], [3020, 276, 3033, 284], [3060, 300, 3073, 308],
        ].map(([x1, y1, x2, y2]) => (
          <line x1={x1} y1={y1} x2={x2} y2={y2} stroke-width="1" opacity="0.3" />
        ))}

        <!-- chimney -->
        <rect x="2822" y="232" width="26" height="68" stroke-width="2" />
        <rect x="2818" y="228" width="34" height="8" stroke-width="2" />
        <line x1="2822" y1="256" x2="2848" y2="256" opacity="0.4" stroke-width="1" />

        <!-- wall -->
        <rect x="2710" y="340" width="380" height="220" stroke-width="2.5" />
        {[2748, 2786, 2824, 2976, 3014, 3052].map((x) => (
          <line x1={x} y1="340" x2={x} y2="560" opacity="0.12" stroke-width="1" />
        ))}

        <!-- door -->
        <rect x="2758" y="420" width="56" height="140" stroke-width="2.5" />
        <rect x="2767" y="432" width="38" height="116" opacity="0.4" stroke-width="1.25" />
        <circle cx="2800" cy="492" r="2.5" opacity="0.7" />

        <!-- plaster reveal around the frame -->
        <rect x="2828" y="386" width="146" height="136" stroke-dasharray="4 5" opacity="0.3" />

        <g id="j-house-window">
          <circle cx="2901" cy="454" r="90" fill="url(#j-glow)" stroke="none" />
          <circle cx="2901" cy="454" r="48" fill="url(#j-glow)" stroke="none" />
          <path
            fill="#f7f5f0"
            fill-rule="evenodd"
            stroke="none"
            d="M2840,398 H2962 V510 H2840 Z M2849,407 H2953 V501 H2849 Z M2901,407 H2911 V501 H2901 Z"
          />
          <rect x="2854" y="412" width="42" height="84" stroke-width="1" opacity="0.3" />
          <rect x="2911" y="412" width="42" height="84" stroke-width="1" opacity="0.3" />
          <rect x="2834" y="510" width="134" height="10" stroke-width="2" />
          <path d="M2849,407 L2840,398 M2953,407 L2962,398 M2849,501 L2840,510 M2953,501 L2962,510" stroke="#f3d9a6" stroke-width="1" opacity="0.18" />
        </g>

        <!-- flower box -->
        <rect x="2866" y="522" width="70" height="14" stroke-width="1.5" />
        {[2878, 2896, 2914].map((x) => (
          <path d={`M${x},522 Q${x + 5},508 ${x + 10},522`} stroke="#85c48c" stroke-width="1.3" opacity="0.6" />
        ))}

        <!-- lantern -->
        <path d="M2963,513 L2975,503 L2987,513 Z" stroke-width="1.3" />
        <rect x="2967" y="513" width="16" height="24" rx="2" stroke-width="1.5" />
        <circle cx="2975" cy="525" r="14" fill="url(#j-glow)" opacity="0.5" stroke="none" />
        <line x1="2967" y1="525" x2="2950" y2="525" stroke-width="1.5" opacity="0.6" />

        <!-- landscaping -->
        <path d="M2772,560 L2762,596 M2800,560 L2810,596" stroke-width="1.5" opacity="0.35" />
        {[572, 582, 592].map((y) => {
          const t = (y - 560) / 36;
          const xL = 2772 - 10 * t;
          const xR = 2800 + 10 * t;
          return <line x1={xL} y1={y} x2={xR} y2={y} opacity="0.25" stroke-width="1" />;
        })}
        <path
          d="M2688,560 Q2686,540 2700,537 Q2708,527 2719,536 Q2734,537 2733,560 Z"
          fill="#3f9a46"
          fill-opacity="0.16"
          stroke="#85c48c"
          stroke-width="1.3"
          opacity="0.7"
        />
        {[2698, 2710, 2722].map((x) => (
          <path d={`M${x},546 Q${x + 4},534 ${x + 8},546`} stroke="#85c48c" stroke-width="1" opacity="0.5" />
        ))}
        <path
          d="M3078,560 Q3076,540 3090,537 Q3098,527 3109,536 Q3124,537 3123,560 Z"
          fill="#3f9a46"
          fill-opacity="0.16"
          stroke="#85c48c"
          stroke-width="1.3"
          opacity="0.7"
        />
        {[3088, 3100, 3112].map((x) => (
          <path d={`M${x},546 Q${x + 4},534 ${x + 8},546`} stroke="#85c48c" stroke-width="1" opacity="0.5" />
        ))}
      </g>
    </svg>
  </div>

  <div class="uf-story-captions-viewport">
    <div class="uf-story-captions-track">
      <div class="uf-story-captions">
        {
          steps.map((step, i) => (
            <div
              class="uf-story-caption"
              id={`j-caption-${i + 1}`}
              data-active={i === 0 ? "true" : "false"}
              style={`left:${(step.xUnit / svgViewBoxWidth) * 100}%`}
            >
              <span class="label-eyebrow text-brass-soft">{step.label}</span>
              <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-stone md:text-base">{step.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="uf-story-controls container-frame">
    <button type="button" class="uf-story-arrow" data-story-prev aria-label="Previous step">
      <svg width="16" height="10" viewBox="0 0 18 10" fill="none"><path d="M18 5H1M1 5L5 1M1 5L5 9" stroke="currentColor" stroke-width="1" /></svg>
    </button>

    <div class="uf-story-dots" role="tablist" aria-label="Story steps">
      {
        steps.map((step, i) => (
          <button
            type="button"
            class="uf-story-dot"
            data-story-dot={i}
            data-active={i === 0 ? "true" : "false"}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={step.label}
          />
        ))
      }
    </div>

    <button type="button" class="uf-story-arrow" data-story-next aria-label="Next step">
      <svg width="16" height="10" viewBox="0 0 18 10" fill="none"><path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1" /></svg>
    </button>
  </div>
</section>

<style>
  .uf-story {
    position: relative;
  }

  .uf-story-heading {
    width: 100%;
    text-align: center;
  }

  .uf-story-viewport {
    width: 100%;
    height: min(42vh, 420px);
    min-height: 240px;
    overflow: hidden;
    position: relative;
  }

  .uf-story-svg {
    height: 100%;
    width: auto;
    display: block;
    will-change: transform;
  }

  .uf-story-scene {
    will-change: opacity;
  }

  /* A normal-width clipping box, exactly like .uf-story-viewport above —
     without it, the track inside (sized to the svg's full ~2600px width by
     JS) sits in normal flow with nothing but body's global overflow-x:hidden
     containing it, which some browsers/input methods don't honour reliably
     and the page becomes horizontally scrollable. overflow-y stays visible
     so a two-line caption isn't clipped vertically. */
  .uf-story-captions-viewport {
    position: relative;
    width: 100%;
    margin-top: 2rem;
    overflow-x: hidden;
    overflow-y: visible;
  }

  /* Shares the svg's exact rendered width (set in JS) and receives the same pan
     tween, so a caption positioned at left:X% always sits under the same viewBox
     coordinate as the artwork above it — text tracks the drawing as it slides. */
  .uf-story-captions-track {
    position: relative;
    width: 100%;
    will-change: transform;
  }

  .uf-story-captions {
    position: relative;
    min-height: 6rem;
    text-align: center;
  }

  .uf-story-caption {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(23rem, 85vw);
    opacity: 0;
    transition: opacity 0.4s var(--ease-precise);
  }

  .uf-story-caption[data-active="true"] {
    opacity: 1;
  }

  .uf-story-controls {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }

  .uf-story-arrow {
    display: flex;
    height: 44px;
    width: 44px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgb(247 245 240 / 0.3);
    color: var(--color-off-white);
    transition: border-color var(--duration-normal) var(--ease-precise), background var(--duration-normal) var(--ease-precise);
  }

  .uf-story-arrow:hover {
    border-color: var(--color-brass-soft);
    background: rgb(174 203 232 / 0.12);
  }

  .uf-story-dots {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .uf-story-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(247 245 240 / 0.25);
    transition: background var(--duration-normal) var(--ease-precise), transform var(--duration-normal) var(--ease-precise);
  }

  .uf-story-dot[data-active="true"] {
    background: var(--color-brass-soft);
    transform: scale(1.3);
  }

  @media (max-width: 640px) {
    .uf-story-viewport {
      height: 34vh;
      min-height: 200px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const section = document.querySelector<HTMLElement>("[data-story-section]");
  if (section) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const viewport = section.querySelector<HTMLElement>(".uf-story-viewport");
    const svg = section.querySelector<SVGSVGElement>(".uf-story-svg");
    const captionsTrack = section.querySelector<HTMLElement>(".uf-story-captions-track");
    const sceneIds = ["j-scene-1", "j-scene-2", "j-scene-3", "j-scene-4", "j-scene-5"];
    const sceneXUnits = [350, 1000, 1650, 2300, 2900];
    const svgViewBoxWidth = 3200;
    const dots = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-story-dot]"));
    const captions = Array.from(section.querySelectorAll<HTMLElement>(".uf-story-caption"));

    if (viewport && svg && captionsTrack) {
      const syncTrackWidth = () => {
        captionsTrack.style.width = `${svg.getBoundingClientRect().width}px`;
      };
      syncTrackWidth();
      window.addEventListener("resize", syncTrackWidth);

      const centerOffset = (xUnit: number) =>
        viewport.getBoundingClientRect().width / 2 - xUnit * (svg.getBoundingClientRect().width / svgViewBoxWidth);

      const panTargets = [svg, captionsTrack];
      let step = 0;
      let animating = false;

      gsap.set(panTargets, { x: centerOffset(sceneXUnits[0]) });
      gsap.set(`#${sceneIds[0]}`, { opacity: 1 });
      if (reduceMotion) {
        // Show every scene softly so a static (non-sliding) page still reads the story.
        sceneIds.forEach((id) => gsap.set(`#${id}`, { opacity: 0.9 }));
      }

      function goTo(target: number) {
        if (animating || target === step || target < 0 || target >= sceneIds.length) return;
        animating = true;
        const prevStep = step;
        step = target;

        dots.forEach((dot, i) => {
          dot.dataset.active = i === step ? "true" : "false";
          dot.setAttribute("aria-selected", i === step ? "true" : "false");
        });
        captions.forEach((cap, i) => (cap.dataset.active = i === step ? "true" : "false"));

        if (reduceMotion) {
          gsap.set(panTargets, { x: centerOffset(sceneXUnits[step]) });
          animating = false;
          return;
        }

        gsap.to(panTargets, { x: centerOffset(sceneXUnits[step]), duration: 0.85, ease: "power3.inOut" });
        gsap.to(`#${sceneIds[prevStep]}`, { opacity: 0, duration: 0.35, ease: "power2.in" });
        gsap.to(`#${sceneIds[step]}`, { opacity: 1, duration: 0.5, delay: 0.25, ease: "power2.out", onComplete: () => (animating = false) });
      }

      section.querySelector("[data-story-next]")?.addEventListener("click", () => goTo((step + 1) % sceneIds.length));
      section.querySelector("[data-story-prev]")?.addEventListener("click", () => goTo((step - 1 + sceneIds.length) % sceneIds.length));
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

      section.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") goTo((step + 1) % sceneIds.length);
        if (e.key === "ArrowLeft") goTo((step - 1 + sceneIds.length) % sceneIds.length);
      });

      // Basic swipe support.
      let touchStartX = 0;
      viewport.addEventListener("touchstart", (e) => (touchStartX = e.touches[0].clientX), { passive: true });
      viewport.addEventListener(
        "touchend",
        (e) => {
          const dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) < 40) return;
          if (dx < 0) goTo((step + 1) % sceneIds.length);
          else goTo((step - 1 + sceneIds.length) % sceneIds.length);
        },
        { passive: true },
      );
    }
  }
</script>
