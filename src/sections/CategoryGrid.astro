---
import Eyebrow from "../components/Eyebrow.astro";

const categories = [
  { name: "Sliding Systems", desc: "Slim residential sliders to all-around concealed panoramic glazing.", href: "/sliding/", icon: "sliding" },
  { name: "Casement Systems", desc: "Precision-hinged windows and doors with concealed hardware.", href: "/casement/", icon: "casement" },
  { name: "Panoramic Sliding", desc: "Graf 73 — our largest-format, all-concealed sliding series.", href: "/graf-73/", icon: "sliding" },
  { name: "Fold & Slide", desc: "Robus 40 fold & slide, for openings up to 2.4 metres.", href: "/robus-40/", icon: "casement" },
  { name: "Facade & Sky Lights", desc: "Structural glazing for full elevations and roof lights.", href: "/facade-sky-lights/", icon: "facade" },
  { name: "Finishes & Colours", desc: "100+ anodised, powder-coated and metallic finishes.", href: "/products/#finishes", icon: "swatch" },
] as const;
---

<section class="bg-off-white py-24 md:py-32" data-reveal-group>
  <div class="container-frame">
    <Eyebrow class="text-ink/65" data-reveal="fade">Explore</Eyebrow>
    <h2 class="mt-6 max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.08] text-ink text-balance" data-reveal="up">
      Every system, by category.
    </h2>
  </div>

  <div class="container-frame mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal="up">
    {
      categories.map((cat) => (
        <a href={cat.href} class="uf-cat-card group relative flex flex-col justify-between border border-ink/10 bg-off-white p-8" data-cursor-hover>
          <span class="uf-cat-icon text-ink/40" aria-hidden="true">
            {cat.icon === "sliding" && (
              <svg viewBox="0 0 34 22" fill="none" width="36" height="24">
                <rect x="1" y="1" width="32" height="20" rx="1.5" stroke="currentColor" stroke-width="1.3" opacity="0.4" />
                <line x1="17" y1="1" x2="17" y2="21" stroke="currentColor" stroke-width="1" opacity="0.4" stroke-dasharray="1.6 2" />
                <rect class="uf-cat-sash" x="2.5" y="2.5" width="13" height="17" stroke="currentColor" stroke-width="1.5" />
              </svg>
            )}
            {cat.icon === "casement" && (
              <svg viewBox="0 0 34 22" fill="none" width="36" height="24">
                <rect x="1" y="1" width="32" height="20" rx="1.5" stroke="currentColor" stroke-width="1.3" opacity="0.4" />
                <rect class="uf-cat-sash" x="2.5" y="2.5" width="14.5" height="17" stroke="currentColor" stroke-width="1.5" />
              </svg>
            )}
            {cat.icon === "facade" && (
              <svg viewBox="0 0 34 22" fill="none" width="36" height="24">
                <rect x="1" y="1" width="32" height="20" rx="1.5" stroke="currentColor" stroke-width="1.3" opacity="0.4" />
                <line x1="12" y1="1" x2="12" y2="21" stroke="currentColor" stroke-width="1" opacity="0.4" />
                <line x1="23" y1="1" x2="23" y2="21" stroke="currentColor" stroke-width="1" opacity="0.4" />
                <line x1="1" y1="11" x2="33" y2="11" stroke="currentColor" stroke-width="1" opacity="0.4" />
              </svg>
            )}
            {cat.icon === "swatch" && (
              <svg viewBox="0 0 34 22" fill="none" width="36" height="24">
                <circle cx="10" cy="11" r="8" stroke="currentColor" stroke-width="1.3" opacity="0.4" />
                <circle class="uf-cat-sash" cx="19" cy="11" r="8" stroke="currentColor" stroke-width="1.5" />
              </svg>
            )}
          </span>

          <span>
            <span class="font-display text-xl text-ink transition-precise">{cat.name}</span>
            <span class="mt-2 block max-w-[22rem] text-sm leading-relaxed text-ink/55">{cat.desc}</span>
          </span>

          <span class="mt-8 inline-flex items-center gap-3 text-ink">
            <span class="label-eyebrow">Know More</span>
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="transition-precise group-hover:translate-x-1">
              <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .uf-cat-card {
    transition: background var(--duration-normal) var(--ease-precise);
  }

  .uf-cat-card:hover {
    background: var(--color-off-white);
  }

  .uf-cat-card:hover .uf-cat-icon {
    color: var(--color-brass);
  }

  .uf-cat-icon {
    transition: color var(--duration-micro) ease;
  }

  .uf-cat-card:hover .uf-cat-sash {
    transition: transform 0.5s var(--ease-precise);
    transform: translateX(3px);
  }
</style>
